# PDA BLISS CORE — backend environment
# Copy to .env for local development. Never commit .env or real secrets.
# Every value below is a placeholder.

NODE_ENV=development
HOST=localhost
PORT=1112
LOG_LEVEL=info

# Comma-separated list of allowed browser origins (CORS + CSRF origin check)
CORS_ORIGINS=http://localhost:1111

# Requests per window per client (global; auth endpoints have stricter limits)
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=1 minute

# Mock demo endpoints under /api/v1/demo (defaults to true outside production)
ENABLE_DEMO_ROUTES=true

# ---------------------------------------------------------------------------
# EP23 — accounts and authentication
# ---------------------------------------------------------------------------

# PostgreSQL (required in production). Use a local development database.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/pdabliss_core

# Public web app origin — every link in an email is built from it.
PUBLIC_APP_URL=http://localhost:1111

# HMAC key for one-time codes and throttling keys: 32+ random characters.
# Required in production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# Sender identity for every CORE email.
MAIL_FROM=PDA BLISS CORE <notify@pdabliss.com>

# smtp = real delivery. dev = local mail sink in DEV_MAIL_DIR (read it with
# `npm run mail:latest`). Defaults to smtp when SMTP_HOST is set, else dev.
# Production requires SMTP.
# MAIL_TRANSPORT=dev
DEV_MAIL_DIR=.mail

# SMTP transport for notify@pdabliss.com — credentials only here, never in Git.
SMTP_HOST=
SMTP_PORT=587
# true = implicit TLS (465); false = STARTTLS (required)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# ---------------------------------------------------------------------------
# Privileged bootstrap — `npm run db:seed`
# ---------------------------------------------------------------------------
# IMPORTANT: in your real .env, PLATFORM_OWNER_EMAIL must be the Platform
# Owner's REAL email address — it becomes the single PLATFORM_OWNER account.
# The seed refuses this placeholder.
PLATFORM_OWNER_EMAIL=owner@example.com
PLATFORM_OWNER_INITIAL_PASSWORD=change-me

PLATFORM_ADMIN_EMAIL=platform.admin@example.com
PLATFORM_ADMIN_INITIAL_PASSWORD=change-me

# Existing privileged passwords are NOT overwritten on re-runs unless this is true.
BOOTSTRAP_RESET_PASSWORDS=false

# ---------------------------------------------------------------------------
# Demo identities — `npm run db:seed:demo` (development/test only; refused in
# production). Each password must be set locally; nothing is hard-coded.
# ---------------------------------------------------------------------------
DEMO_COMPANY_OWNER_EMAIL=owner.demo@pdabliss.com
DEMO_COMPANY_OWNER_PASSWORD=
DEMO_SYSTEM_ADMIN_EMAIL=admin.demo@pdabliss.com
DEMO_SYSTEM_ADMIN_PASSWORD=
DEMO_EXECUTIVE_EMAIL=executive.demo@pdabliss.com
DEMO_EXECUTIVE_PASSWORD=
DEMO_STAFF_EMAIL=staff.demo@pdabliss.com
DEMO_STAFF_PASSWORD=
# EP28.1 department personas (docs/DEMO_PERSONAS.md). Each is seeded only when
# its password is set; the addresses are fixed (sales.demo@…, operations.demo@…,
# warehouse.demo@…, purchasing.demo@…, accounting.demo@pdabliss.com).
DEMO_SALES_PASSWORD=
DEMO_OPERATIONS_PASSWORD=
DEMO_WAREHOUSE_PASSWORD=
DEMO_PURCHASING_PASSWORD=
DEMO_ACCOUNTING_PASSWORD=

# ---------------------------------------------------------------------------
# Tests — an isolated *_test database (its schema is rebuilt on every run).
# Usually set in backend/.env.test (git-ignored) instead.
# ---------------------------------------------------------------------------
# TEST_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/pdabliss_core_test

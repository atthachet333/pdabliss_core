# PDA BLISS CORE — backend environment
# Copy to .env for local development. Never commit real secrets.

NODE_ENV=development
HOST=localhost
PORT=1112
LOG_LEVEL=info

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:1111

# Requests per window per client
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=1 minute

# Mock demo endpoints under /api/v1/demo (defaults to true outside production)
ENABLE_DEMO_ROUTES=true

# PostgreSQL connection (not required in EP00 — no database access yet)
# DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/pdabliss_core

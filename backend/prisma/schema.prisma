// PDA BLISS CORE — data model
//
// EP00 modelled the identity & access core. EP23 makes identity real: one
// human = one User (a platform-wide account), credentials, sessions, one-time
// codes, email tokens, platform roles and the auth audit trail.
//
// Business documents (SalesOrder, PurchaseRequest, PurchaseOrder, GoodsReceipt,
// StockMovement, Lot, WorkOrder, PaymentRequest, …) are planned in
// docs/ARCHITECTURE.md and arrive in later episodes with their workflows.
//
// One CORE workspace = one Company. A user belongs to at most one company in
// v1 (no company switching). EP24 adds the company lifecycle, branches (with
// exactly one Head Office), the package catalog snapshot on subscriptions and
// department entitlements. Payment processing is a later episode.
//
// Secrets are never stored raw: tokens and one-time codes are stored as hashes
// (see src/auth/crypto.ts), passwords as Argon2id hashes.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Companies (customer workspaces)
// ---------------------------------------------------------------------------

/// Operational lifecycle of a customer company (EP24). Payment-gated activation
/// arrives with billing; until then activation is a manual platform action.
enum CompanyStatus {
  /// Created through onboarding; its subscription is not active yet. Account Portal only.
  PENDING_SUBSCRIPTION
  /// May enter CORE (together with an ACTIVE subscription).
  ACTIVE
  /// Operational access blocked (by the platform).
  SUSPENDED
  /// Permanently closed. Records are kept.
  CLOSED
}

/// Setup progress, separate from the operational status.
enum CompanyOnboardingStatus {
  /// Created; something still has to be agreed (e.g. Enterprise departments).
  IN_PROGRESS
  /// Company, Head Office, owner, departments and subscription are in place.
  COMPLETED
}

model Company {
  id                 String                  @id @default(cuid())
  /// Display name (how the company is shown in CORE).
  name               String
  /// Registered legal name (Thai or any script, UTF-8).
  legalName          String?
  /// Thai 13-digit tax ID when given (format-checked only, not verified with the Revenue Department).
  taxId              String?
  /// Company registration number, when it differs from the tax ID.
  registrationNumber String?
  /// English name, when the company uses one (EP25).
  englishName        String?
  /// Main company phone, E.164 (EP25).
  phone              String?
  /// Public website, https:// or http:// only (EP25).
  website            String?
  /// Company contact address, when separate from the owner's account (EP25).
  contactEmail       String?
  /// Business type (EP25) — the same categories as sign-up; descriptive only, never authorization.
  industry           SignupIndustry?
  timezone           String                  @default("Asia/Bangkok")
  /// Company default language (EP25): invitation emails default to it.
  defaultLocale      AppLocale               @default(th)
  status             CompanyStatus           @default(PENDING_SUBSCRIPTION)
  onboardingStatus   CompanyOnboardingStatus @default(IN_PROGRESS)
  /// The account that created the company through onboarding (null for seeded data).
  createdById        String?
  createdBy          User?                   @relation("CompanyCreator", fields: [createdById], references: [id])
  /// Seeded demonstration data, never a real customer (EP23 demo seed).
  isDemo             Boolean                 @default(false)
  activatedAt        DateTime?
  suspendedAt        DateTime?
  closedAt           DateTime?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  departments        Department[]
  members            CompanyMember[]
  roles              Role[]
  invitations        Invitation[]
  branches           Branch[]
  subscriptions      Subscription[]
  auditLogs          AuditLog[]
  logo               CompanyLogo?
  /// EP28 operational master data (company-scoped canonical records).
  codeSequences      MasterCodeSequence[]
  customers          Customer[]
  suppliers          Supplier[]
  units              Unit[]
  itemCategories     ItemCategory[]
  items              Item[]

  @@index([status])
  @@index([onboardingStatus])
  /// Platform Company Explorer: newest first, cursor by id (EP24.1).
  @@index([createdAt(sort: Desc), id(sort: Desc)])
}

/// Company logo (EP25). Stored in the database, not on disk: no file paths, no
/// public bucket, nothing executable. Raster images only (PNG / JPEG / WebP),
/// checked by their leading bytes, at most 256 KB. Served by the API with its
/// stored content type and nosniff. A future object store replaces `data`.
model CompanyLogo {
  companyId    String   @id
  company      Company  @relation(fields: [companyId], references: [id])
  contentType  String
  byteSize     Int
  /// SHA-256 of the bytes (base64url) — cache key / ETag.
  sha256       String
  data         Bytes
  uploadedById String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// The six standard CORE departments (EP24 canonical codes).
enum DepartmentCode {
  SALES
  OPERATIONS
  WAREHOUSE
  PURCHASING
  ACCOUNTING
  EXECUTIVE
}

/// A department the company has enabled (entitlement / configuration only — no
/// operational tables yet). The plan limits how many may be enabled. EP25:
/// disabling is soft (`isActive = false`): the row and its assignments stay.
model Department {
  id          String         @id @default(cuid())
  companyId   String
  company     Company        @relation(fields: [companyId], references: [id])
  code        DepartmentCode
  name        String
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  memberships Membership[]

  @@unique([companyId, code])
}

/// Which branches a membership may work in (EP26). Every membership that
/// existed before EP26 is ALL_BRANCHES — nobody is locked out by the upgrade.
/// The Company Owner is always ALL_BRANCHES (database CHECK).
enum BranchAccessScope {
  /// Every active branch of the company, including branches added later.
  ALL_BRANCHES
  /// Only the branches listed in MemberBranchAccess.
  SELECTED_BRANCHES
}

/// Customer-level role inside one company (EP23 foundation; enforced from EP25/EP26).
/// Never confused with platform roles: SYSTEM_ADMIN administers one company,
/// PLATFORM_ADMIN operates PDA BLISS CORE itself.
enum CompanyRole {
  COMPANY_OWNER
  SYSTEM_ADMIN
  EXECUTIVE
  DEPARTMENT_MANAGER
  DEPARTMENT_STAFF
  VIEWER
}

/// Membership in a company (EP25). Deactivation is soft: the record and its
/// history stay; the person simply loses access to the company.
enum CompanyMemberStatus {
  ACTIVE
  DEACTIVATED
}

/// A user's place in a company. Department access (Membership) comes on top (EP25 foundation).
model CompanyMember {
  id                  String                     @id @default(cuid())
  companyId           String
  company             Company                    @relation(fields: [companyId], references: [id])
  userId              String
  user                User                       @relation(fields: [userId], references: [id])
  role                CompanyRole
  /// TRUE only for the COMPANY_OWNER (NULL otherwise): one owner per company,
  /// enforced by the database (unique + CHECK, EP24). The owner is always ACTIVE (CHECK, EP25).
  ownerSlot           Boolean?
  status              CompanyMemberStatus        @default(ACTIVE)
  /// Job title inside this company (set by company administration; not a permission).
  jobTitle            String?
  deactivatedAt       DateTime?
  /// Operational branch access (EP26). Administration authority does not depend on it.
  branchScope         BranchAccessScope          @default(ALL_BRANCHES)
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt
  branchAccess        MemberBranchAccess[]
  /// Per-member exceptions to the role's operational permissions (EP27).
  permissionOverrides MemberPermissionOverride[]

  /// v1 policy: one company per user (no company switching).
  @@unique([userId])
  @@unique([companyId, ownerSlot])
  /// Target of MemberBranchAccess's company-bound foreign key (EP26).
  @@unique([id, companyId])
  @@index([companyId])
}

/// Effect of a per-member permission exception (EP27). DENY beats every ALLOW.
enum PermissionEffect {
  ALLOW
  DENY
}

/// A per-member exception to the role's default operational permissions
/// (EP27). Only codes of the canonical catalog (backend/src/permissions/
/// catalog.ts) are accepted — the API validates, and a database CHECK lists
/// the operational codes. Company-administration permissions follow the role
/// and never appear here; the owner has none. The foreign key carries the
/// company id, so an exception can never point into another company. An
/// exception for a department that is later disabled stays (inactive) and
/// returns with the department.
model MemberPermissionOverride {
  id          String           @id @default(cuid())
  companyId   String
  memberId    String
  member      CompanyMember    @relation(fields: [memberId, companyId], references: [id, companyId], onDelete: Cascade)
  permission  String
  effect      PermissionEffect
  createdById String?
  updatedById String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([memberId, permission])
  @@index([companyId])
}

/// One branch a SELECTED_BRANCHES membership may work in (EP26). Both foreign
/// keys carry the company id, so the database refuses a grant that would mix
/// companies; a branch appears at most once per membership.
model MemberBranchAccess {
  id          String        @id @default(cuid())
  companyId   String
  memberId    String
  member      CompanyMember @relation(fields: [memberId, companyId], references: [id, companyId], onDelete: Cascade)
  branchId    String
  branch      Branch        @relation(fields: [branchId, companyId], references: [id, companyId])
  grantedById String?
  createdAt   DateTime      @default(now())

  @@unique([memberId, branchId])
  @@index([branchId])
  @@index([companyId])
}

// ---------------------------------------------------------------------------
// Branches (EP24). Every company has exactly one Head Office (code 00000).
// v1: members see every branch of their company; branch scoping comes later.
// ---------------------------------------------------------------------------

enum BranchType {
  HEAD_OFFICE
  BRANCH
}

enum BranchStatus {
  ACTIVE
  /// Closed permanently (platform-controlled; not used by customers in EP25).
  CLOSED
  /// Deactivated by the company (EP25); can be reactivated. Never the Head Office.
  INACTIVE
}

model Branch {
  id             String               @id @default(cuid())
  companyId      String
  company        Company              @relation(fields: [companyId], references: [id])
  /// Stable 5-digit code, unique per company; the Head Office is 00000.
  code           String
  name           String
  type           BranchType
  status         BranchStatus         @default(ACTIVE)
  /// TRUE only for the Head Office (NULL otherwise): at most one per company in
  /// the database; onboarding creates it in the same transaction as the company.
  headOfficeSlot Boolean?
  addressLine1   String
  addressLine2   String?
  /// Sub-district / tambon (Thailand) or locality.
  subdistrict    String?
  /// District / amphoe / khet, or city.
  district       String?
  /// Province / state / region.
  province       String
  postalCode     String
  /// ISO 3166-1 alpha-2.
  countryCode    String               @default("TH")
  phone          String?
  deactivatedAt  DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  /// Sessions working in this branch (EP25 branch context).
  sessions       Session[]
  /// Memberships granted this branch specifically (EP26).
  memberAccess   MemberBranchAccess[]
  /// Physical locations inside this branch (EP28).
  locations      WarehouseLocation[]

  @@unique([companyId, code])
  @@unique([companyId, headOfficeSlot])
  /// Target of MemberBranchAccess's company-bound foreign key (EP26).
  @@unique([id, companyId])
  @@index([companyId])
}

// ---------------------------------------------------------------------------
// Subscriptions (EP24 foundation — no payment processing)
// ---------------------------------------------------------------------------

enum PlanCode {
  STARTER
  BUSINESS
  PROFESSIONAL
  ENTERPRISE
}

enum BillingCycle {
  MONTHLY
  ANNUAL
}

enum SubscriptionStatus {
  /// Created by onboarding; not paid and not active. Payment / manual activation pending.
  PENDING
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELED
  EXPIRED
}

/// One subscription = one company, every branch included. The plan definition is
/// snapshotted at creation so later catalog changes never rewrite its meaning.
model Subscription {
  id                     String             @id @default(cuid())
  companyId              String
  company                Company            @relation(fields: [companyId], references: [id])
  plan                   PlanCode
  status                 SubscriptionStatus @default(PENDING)
  billingCycle           BillingCycle       @default(MONTHLY)
  /// PLAN_CATALOG_VERSION the snapshot below was taken from.
  catalogVersion         Int
  /// THB per month at creation; NULL for a quotation plan (Enterprise).
  monthlyPriceThb        Int?
  /// The plan's entitlements at creation (limits, storage, API, …), from the catalog.
  entitlements           Json
  /// TRUE for the company's current subscription (NULL once canceled / expired).
  currentSlot            Boolean?
  startsAt               DateTime?
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean            @default(false)
  activatedAt            DateTime?
  endedAt                DateTime?
  /// Future payment provider references (none in EP24).
  paymentProvider        String?
  providerSubscriptionId String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  @@unique([companyId, currentSlot])
  @@index([companyId, status])
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

enum UserStatus {
  /// Self-registered; the email address is not verified yet. No authenticated access.
  PENDING_VERIFICATION
  ACTIVE
  /// Temporarily blocked by the platform or the company. Sessions are revoked.
  SUSPENDED
  /// Permanently closed.
  DISABLED
}

enum AppLocale {
  th
  en
  zh_CN
}

/// Self-described work area of the person (EP24.1). Profile information only —
/// it never grants a role, a department or any permission.
enum JobFunction {
  OWNER
  EXECUTIVE
  ACCOUNTING
  PURCHASING
  SALES
  OPERATIONS
  WAREHOUSE
  IT
  OTHER
}

/// Business context a person gives at sign-up (EP24.1) — lead information for
/// PDA BLISS. It is NOT the company record (that is created in onboarding) and
/// it never grants anything.
enum SignupIndustry {
  DISTRIBUTION
  SERVICES
  PROJECTS
  RETAIL
  PROPERTY
  MANUFACTURING
  OTHER
}

enum SignupTeamSize {
  SIZE_1_10
  SIZE_11_50
  SIZE_51_200
  SIZE_201_500
  SIZE_500_PLUS
}

enum ContactPreference {
  EMAIL
  PHONE
  LINE
}

enum SignupInterest {
  SALES
  WAREHOUSE
  PURCHASING
  OPERATIONS
  ACCOUNTING_WORKFLOW
  EXECUTIVE_VISIBILITY
  FULL_ORGANIZATION
}

model AccountSignupContext {
  userId           String            @id
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// The company the person says they represent (free text; not verified, not a Company row).
  companyName      String
  industry         SignupIndustry
  teamSize         SignupTeamSize
  preferredContact ContactPreference @default(EMAIL)
  /// LINE ID when LINE is the preferred contact.
  lineId           String?
  interests        SignupInterest[]
  /// Optional needs / pain points in the person's own words.
  note             String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

/// One human = one account, across the whole platform.
model User {
  id               String                   @id @default(cuid())
  /// As entered (trimmed), for display and for sending mail.
  email            String
  /// Lower-cased, trimmed, NFC — the identity key. Unique.
  emailNormalized  String                   @unique
  /// The person's full name (EP24.1: required at registration; NULL only for older accounts).
  fullName         String?
  /// Contact phone, normalized to E.164 (e.g. +66812345678). Profile data — not an MFA factor.
  phone            String?
  /// Self-described work area; never an authorization input.
  jobFunction      JobFunction?
  locale           AppLocale                @default(th)
  status           UserStatus               @default(PENDING_VERIFICATION)
  emailVerifiedAt  DateTime?
  /// Package chosen before company creation (lower-case plan id; onboarding intent — no subscription).
  planIntent       String?
  /// When the package was last chosen in the Account Portal (EP24).
  planSelectedAt   DateTime?
  lastLoginAt      DateTime?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  credential       UserCredential?
  platformRole     PlatformRoleAssignment?  @relation("PlatformRoleHolder")
  grantedRoles     PlatformRoleAssignment[] @relation("PlatformRoleGrantor")
  companyMember    CompanyMember?
  memberships      Membership[]
  sessions         Session[]
  trustedDevices   TrustedDevice[]
  otpChallenges    OtpChallenge[]
  emailTokens      EmailVerificationToken[]
  resetTokens      PasswordResetToken[]
  invitationsSent  Invitation[]             @relation("InvitationInviter")
  invitationsUsed  Invitation[]             @relation("InvitationAcceptor")
  authEvents       AuthAuditEvent[]         @relation("AuthEventUser")
  actedEvents      AuthAuditEvent[]         @relation("AuthEventActor")
  auditLogs        AuditLog[]
  companiesCreated Company[]                @relation("CompanyCreator")
  signupContext    AccountSignupContext?

  @@index([status])
}

/// Password credential, separate from the profile so it is never selected by accident.
model UserCredential {
  userId            String   @id
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// PHC string (algorithm and cost parameters included) — upgraded on login when parameters change.
  passwordHash      String
  passwordChangedAt DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

enum PlatformRole {
  /// The highest PDA BLISS CORE authority. Exactly one, bootstrapped from PLATFORM_OWNER_EMAIL.
  PLATFORM_OWNER
  /// Operational PDA BLISS administrator, below the owner.
  PLATFORM_ADMIN
}

/// Platform-level authority (not a department, not a company role).
model PlatformRoleAssignment {
  id          String       @id @default(cuid())
  userId      String       @unique
  user        User         @relation("PlatformRoleHolder", fields: [userId], references: [id])
  role        PlatformRole
  /// TRUE only for PLATFORM_OWNER (NULL otherwise). Unique, so the database
  /// itself refuses a second owner.
  ownerSlot   Boolean?     @unique
  grantedById String?
  grantedBy   User?        @relation("PlatformRoleGrantor", fields: [grantedById], references: [id])
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

// ---------------------------------------------------------------------------
// Sessions and devices
// ---------------------------------------------------------------------------

enum SessionRevokeReason {
  LOGOUT
  LOGOUT_ALL
  REVOKED_BY_USER
  PASSWORD_RESET
  ACCOUNT_SUSPENDED
  ROLE_CHANGED
  ROTATED
}

/// Server-side session. The browser holds a random token in an HttpOnly cookie;
/// only its SHA-256 hash is stored here.
model Session {
  id                 String               @id @default(cuid())
  userId             String
  user               User                 @relation(fields: [userId], references: [id])
  tokenHash          String               @unique
  /// The token before the last rotation, accepted briefly so in-flight requests survive it.
  previousTokenHash  String?              @unique
  previousValidUntil DateTime?
  /// Privileged (platform) sessions get shorter lifetimes and stricter step-up.
  privileged         Boolean              @default(false)
  createdAt          DateTime             @default(now())
  lastSeenAt         DateTime             @default(now())
  rotatedAt          DateTime             @default(now())
  idleExpiresAt      DateTime
  absoluteExpiresAt  DateTime
  /// Last successful one-time-code check in this session (login or step-up).
  stepUpAt           DateTime?
  revokedAt          DateTime?
  revokeReason       SessionRevokeReason?
  ipAddress          String?
  userAgent          String?
  /// EP25 branch context: the branch this session works in, chosen through
  /// /company/context/branch and re-validated on every operational request.
  branchId           String?
  branch             Branch?              @relation(fields: [branchId], references: [id], onDelete: SetNull)
  branchSelectedAt   DateTime?

  @@index([userId, revokedAt])
  @@index([absoluteExpiresAt])
}

/// A browser that completed an email one-time code ("new device" check). Customer
/// accounts only — platform accounts are challenged on every sign-in.
model TrustedDevice {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  tokenHash  String    @unique
  userAgent  String?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?

  @@index([userId])
}

// ---------------------------------------------------------------------------
// One-time codes and email tokens
// ---------------------------------------------------------------------------

enum OtpPurpose {
  LOGIN
  STEP_UP
}

enum OtpStatus {
  PENDING
  VERIFIED
  /// Replaced by a newer challenge for the same user and purpose.
  SUPERSEDED
  /// Too many wrong codes.
  LOCKED
  /// Invalidated by a security change (e.g. password reset).
  CANCELLED
}

/// Email one-time code. The code is stored as an HMAC (keyed by AUTH_SECRET).
model OtpChallenge {
  id          String     @id @default(cuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id])
  purpose     OtpPurpose
  status      OtpStatus  @default(PENDING)
  codeHash    String
  /// LOGIN: hash of the browser-bound pending-login cookie. STEP_UP: unused.
  bindingHash String?
  /// STEP_UP: the session being elevated.
  sessionId   String?
  attempts    Int        @default(0)
  maxAttempts Int        @default(5)
  sendCount   Int        @default(1)
  lastSentAt  DateTime   @default(now())
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([userId, purpose, status])
  @@index([createdAt])
}

model EmailVerificationToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  tokenHash  String    @unique
  expiresAt  DateTime
  usedAt     DateTime?
  /// Set when a newer token replaced this one.
  replacedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, createdAt])
}

model PasswordResetToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  tokenHash  String    @unique
  expiresAt  DateTime
  usedAt     DateTime?
  replacedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, createdAt])
}

// ---------------------------------------------------------------------------
// Invitations (foundation for the Company Control Center)
// ---------------------------------------------------------------------------

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
}

model Invitation {
  id              String            @id @default(cuid())
  companyId       String
  company         Company           @relation(fields: [companyId], references: [id])
  /// The invitee address, bound: only an account with this normalized email can accept.
  email           String
  emailNormalized String
  role            CompanyRole
  /// Language of the invitation email (EP25; NULL for older invitations).
  locale          AppLocale?
  tokenHash       String            @unique
  status          InvitationStatus  @default(PENDING)
  invitedById     String
  invitedBy       User              @relation("InvitationInviter", fields: [invitedById], references: [id])
  expiresAt       DateTime
  acceptedAt      DateTime?
  acceptedById    String?
  acceptedBy      User?             @relation("InvitationAcceptor", fields: [acceptedById], references: [id])
  revokedAt       DateTime?
  /// EP26 intent, re-validated at acceptance: departments to assign (only those
  /// still enabled are applied) and the branch access to give.
  departments     DepartmentCode[]  @default([])
  branchScope     BranchAccessScope @default(ALL_BRANCHES)
  /// Branch ids for SELECTED_BRANCHES (only active branches of the company are applied).
  branchIds       String[]          @default([])
  /// Set on the replacement when an invitation is resent (the old row is revoked).
  resentFromId    String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([companyId, status])
  @@index([companyId, createdAt])
  @@index([emailNormalized])
}

// ---------------------------------------------------------------------------
// Audit
// ---------------------------------------------------------------------------

enum AuthEventType {
  REGISTER
  REGISTER_EXISTING_EMAIL
  EMAIL_VERIFICATION_SENT
  EMAIL_VERIFIED
  LOGIN_SUCCESS
  LOGIN_FAILURE
  OTP_SENT
  OTP_SUCCESS
  OTP_FAILURE
  STEP_UP_SUCCESS
  PASSWORD_RESET_REQUEST
  PASSWORD_RESET_SUCCESS
  LOGOUT
  LOGOUT_ALL
  SESSION_REVOKED
  INVITATION_CREATED
  INVITATION_ACCEPTED
  INVITATION_REVOKED
  PLATFORM_ROLE_GRANTED
  PLATFORM_ROLE_REVOKED
  ACCOUNT_SUSPENDED
  ACCOUNT_REACTIVATED
  PLATFORM_BOOTSTRAP
  /// Development only: a seeded demo customer signed in without the emailed code.
  DEMO_AUTH_BYPASS
}

/// Security-relevant authentication events. Append-only; never holds secrets.
model AuthAuditEvent {
  id          String        @id @default(cuid())
  type        AuthEventType
  /// The account the event is about (when known).
  userId      String?
  user        User?         @relation("AuthEventUser", fields: [userId], references: [id])
  /// Who performed it, when different from the subject (platform actions).
  actorId     String?
  actor       User?         @relation("AuthEventActor", fields: [actorId], references: [id])
  sessionId   String?
  /// HMAC of the normalized email for attempts on unknown or unauthenticated
  /// accounts — lets throttling count attempts without storing the address.
  subjectHash String?
  ipAddress   String?
  userAgent   String?
  requestId   String?
  /// Small, non-secret context (e.g. a coarse failure reason).
  metadata    Json?
  occurredAt  DateTime      @default(now())

  @@index([userId, occurredAt])
  @@index([subjectHash, type, occurredAt])
  @@index([type, occurredAt])
}

// ---------------------------------------------------------------------------
// Department access (EP00 foundation; used from EP26)
// ---------------------------------------------------------------------------

/// A user's access inside a department (EP25: the department assignment).
/// One human = one User; working in several departments means several rows,
/// never several accounts. The optional department Role (fine-grained
/// permissions) arrives with EP27.
model Membership {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id])
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  roleId       String?
  role         Role?      @relation(fields: [roleId], references: [id])
  isPrimary    Boolean    @default(false)
  createdAt    DateTime   @default(now())

  @@unique([userId, departmentId])
  @@index([departmentId])
}

model Role {
  id          String           @id @default(cuid())
  companyId   String
  company     Company          @relation(fields: [companyId], references: [id])
  code        String
  name        String
  isSystem    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  permissions RolePermission[]
  memberships Membership[]

  @@unique([companyId, code])
}

/// Permission codes are defined in code (e.g. "purchasing.pr.approve").
model Permission {
  id          String           @id @default(cuid())
  code        String           @unique
  description String
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id])
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
}

/// Append-only audit trail with before/after field changes (business entities).
/// EP24: company onboarding and subscription events (see src/company/audit.ts).
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id])
  /// The company the action concerns, when there is one.
  companyId  String?
  company    Company? @relation(fields: [companyId], references: [id])
  action     String
  entityType String
  entityId   String
  requestId  String
  reason     String?
  changes    Json
  occurredAt DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId, occurredAt])
  @@index([companyId, occurredAt])
}

// ---------------------------------------------------------------------------
// Operational master data (EP28) — docs/OPERATIONAL_MASTER_DATA.md
//
// ONE canonical record per business identity, shared by every department:
// Sales, Purchasing, Warehouse, Operations and Accounting reference these ids
// and never keep their own copies. Customers, suppliers, items, units and
// categories belong to exactly one Company; warehouse locations belong to one
// Branch of that company. Every relation carries the company id in its
// foreign key, so a record can never point into another company.
//
// Nothing is hard-deleted: records are deactivated (INACTIVE) and stay
// identifiable for history. Codes are business identifiers, unique per
// company (per branch for locations) and immutable once created. No price,
// cost, margin, payment term or balance lives here — identity only.
// ---------------------------------------------------------------------------

/// Lifecycle of a master record. INACTIVE refuses new use (future workflows)
/// but keeps the record readable and historically identifiable.
enum MasterStatus {
  ACTIVE
  INACTIVE
}

/// Per-company counters behind generated codes (CUS-000001, FG-000001, …).
/// Incremented with one atomic upsert inside the transaction that creates the
/// record, so concurrent creates never share a number and a failed create
/// leaves no gap.
model MasterCodeSequence {
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  /// The code prefix, e.g. CUS, SUP, FG, RM.
  prefix    String
  lastValue Int      @default(0)
  updatedAt DateTime @updatedAt

  @@id([companyId, prefix])
}

enum CustomerKind {
  INDIVIDUAL
  BUSINESS
}

/// The canonical customer (EP28). Identity and contact only — no credit,
/// receivable, aging or revenue figures (those are workflow / reporting data).
model Customer {
  id              String       @id @default(cuid())
  companyId       String
  company         Company      @relation(fields: [companyId], references: [id])
  /// Company-unique, immutable (generated CUS-000001 or entered on creation).
  code            String
  kind            CustomerKind @default(BUSINESS)
  /// Display / trading name.
  name            String
  legalName       String?
  /// Normalized (no spaces or dashes, upper case). Optional; not assumed Thai.
  taxId           String?
  /// Tax branch text, e.g. "สำนักงานใหญ่" or "00001".
  taxBranch       String?
  contactName     String?
  /// E.164 when given.
  phone           String?
  email           String?
  lineId          String?
  billingAddress  String?
  shippingAddress String?
  notes           String?
  status          MasterStatus @default(ACTIVE)
  deactivatedAt   DateTime?
  createdById     String?
  updatedById     String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([companyId, code])
  /// Target of company-bound foreign keys from future documents.
  @@unique([id, companyId])
  @@index([companyId, status])
  @@index([companyId, name])
}

/// The canonical supplier (EP28) — GENERAL identity only. Financial terms
/// (payment terms, bank accounts, prices) belong to future Purchasing /
/// Accounting records that Warehouse never receives; none is stored here.
model Supplier {
  id            String       @id @default(cuid())
  companyId     String
  company       Company      @relation(fields: [companyId], references: [id])
  code          String
  name          String
  legalName     String?
  taxId         String?
  taxBranch     String?
  contactName   String?
  phone         String?
  email         String?
  address       String?
  notes         String?
  status        MasterStatus @default(ACTIVE)
  deactivatedAt DateTime?
  createdById   String?
  updatedById   String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@unique([companyId, code])
  @@unique([id, companyId])
  @@index([companyId, status])
  @@index([companyId, name])
}

/// A unit of measure (PCS, KG, L, BOX, …). `precision` is the number of
/// decimal places a quantity in this unit may carry (0 = whole numbers);
/// future quantities are exact decimals, never floating point.
model Unit {
  id            String       @id @default(cuid())
  companyId     String
  company       Company      @relation(fields: [companyId], references: [id])
  code          String
  name          String
  symbol        String?
  precision     Int          @default(0)
  status        MasterStatus @default(ACTIVE)
  deactivatedAt DateTime?
  createdById   String?
  updatedById   String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  items         Item[]

  @@unique([companyId, code])
  @@unique([id, companyId])
  @@index([companyId, status])
}

/// A flat item category (v1: no hierarchy).
model ItemCategory {
  id            String       @id @default(cuid())
  companyId     String
  company       Company      @relation(fields: [companyId], references: [id])
  code          String
  name          String
  description   String?
  status        MasterStatus @default(ACTIVE)
  deactivatedAt DateTime?
  createdById   String?
  updatedById   String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  items         Item[]

  @@unique([companyId, code])
  @@unique([id, companyId])
  @@index([companyId, status])
}

/// What an item is. NON_STOCK items (services, fees) never track inventory.
enum ItemType {
  FINISHED_GOOD
  RAW_MATERIAL
  PACKAGING
  CONSUMABLE
  NON_STOCK
}

/// Whether future stock of an item carries a lot / an expiry date.
enum TrackingRequirement {
  NONE
  OPTIONAL
  REQUIRED
}

/// The canonical item (EP28) — the one identity Sales, Purchasing, Warehouse
/// and Operations reference. Identity and tracking requirements only: no
/// quantity, cost, price or margin. Tracking rules (database CHECKs):
/// NON_STOCK ⇒ not inventory tracked; not tracked ⇒ no lot / expiry; expiry is
/// recorded per lot, so expiry tracking needs lot tracking at least as strict.
/// Base unit and tracking change only through the structure policy
/// (src/master-data/policy.ts) — the point future Warehouse locks.
model Item {
  id               String              @id @default(cuid())
  companyId        String
  company          Company             @relation(fields: [companyId], references: [id])
  /// Company-unique, immutable (generated FG-000001 … or entered on creation).
  code             String
  /// Fixed at creation (it chose the code prefix).
  type             ItemType
  name             String
  description      String?
  /// Internal reference / SKU, company-unique when given.
  sku              String?
  /// Barcode (GTIN / EAN / internal), company-unique when given. No scanning yet.
  barcode          String?
  baseUnitId       String
  baseUnit         Unit                @relation(fields: [baseUnitId, companyId], references: [id, companyId])
  categoryId       String?
  category         ItemCategory?       @relation(fields: [categoryId, companyId], references: [id, companyId])
  inventoryTracked Boolean             @default(true)
  lotTracking      TrackingRequirement @default(NONE)
  expiryTracking   TrackingRequirement @default(NONE)
  status           MasterStatus        @default(ACTIVE)
  deactivatedAt    DateTime?
  createdById      String?
  updatedById      String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@unique([companyId, code])
  @@unique([companyId, sku])
  @@unique([companyId, barcode])
  @@unique([id, companyId])
  @@index([companyId, status])
  @@index([companyId, type])
  @@index([companyId, name])
  @@index([categoryId])
  @@index([baseUnitId])
}

/// A physical place inside one branch (MAIN, RECEIVING, RACK-A, A-01, …).
/// Code unique within the branch. Optional parent in the same branch (the
/// parent foreign key carries the branch id; the service refuses cycles and
/// depth beyond 4). At most one default location per branch. No stock here.
model WarehouseLocation {
  id            String              @id @default(cuid())
  companyId     String
  branchId      String
  branch        Branch              @relation(fields: [branchId, companyId], references: [id, companyId])
  code          String
  name          String
  description   String?
  parentId      String?
  parent        WarehouseLocation?  @relation("LocationTree", fields: [parentId, branchId], references: [id, branchId])
  children      WarehouseLocation[] @relation("LocationTree")
  /// TRUE for the branch's default operational location (NULL otherwise).
  defaultSlot   Boolean?
  status        MasterStatus        @default(ACTIVE)
  deactivatedAt DateTime?
  createdById   String?
  updatedById   String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@unique([branchId, code])
  @@unique([branchId, defaultSlot])
  @@unique([id, branchId])
  @@unique([id, companyId])
  @@index([companyId, status])
  @@index([parentId])
}

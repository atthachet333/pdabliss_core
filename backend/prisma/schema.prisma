// PDA BLISS CORE — data model
//
// EP00 modelled the identity & access core. EP23 makes identity real: one
// human = one User (a platform-wide account), credentials, sessions, one-time
// codes, email tokens, platform roles and the auth audit trail.
//
// Business documents (SalesOrder, PurchaseRequest, PurchaseOrder, GoodsReceipt,
// StockMovement, Lot, WorkOrder, PaymentRequest, …) are planned in
// docs/ARCHITECTURE.md and arrive in later episodes with their workflows.
//
// One CORE workspace = one Company. A user belongs to at most one company in
// v1 (no company switching). EP24 adds the company lifecycle, branches (with
// exactly one Head Office), the package catalog snapshot on subscriptions and
// department entitlements. Payment processing is a later episode.
//
// Secrets are never stored raw: tokens and one-time codes are stored as hashes
// (see src/auth/crypto.ts), passwords as Argon2id hashes.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Companies (customer workspaces)
// ---------------------------------------------------------------------------

/// Operational lifecycle of a customer company (EP24). Payment-gated activation
/// arrives with billing; until then activation is a manual platform action.
enum CompanyStatus {
  /// Created through onboarding; its subscription is not active yet. Account Portal only.
  PENDING_SUBSCRIPTION
  /// May enter CORE (together with an ACTIVE subscription).
  ACTIVE
  /// Operational access blocked (by the platform).
  SUSPENDED
  /// Permanently closed. Records are kept.
  CLOSED
}

/// Setup progress, separate from the operational status.
enum CompanyOnboardingStatus {
  /// Created; something still has to be agreed (e.g. Enterprise departments).
  IN_PROGRESS
  /// Company, Head Office, owner, departments and subscription are in place.
  COMPLETED
}

/// EP41 separation of duties (docs/EP41_APPROVAL_POLICY.md).
enum ApprovalPolicy {
  /// Pre-EP41: the decision's permission alone decides.
  SELF_APPROVAL_ALLOWED
  /// A consequential decision is made by someone other than the document's originators
  /// (the owner may override, audited).
  INDEPENDENT_APPROVAL
}

model Company {
  id                 String                  @id @default(cuid())
  /// EP41: existing companies keep SELF_APPROVAL_ALLOWED; onboarding sets INDEPENDENT_APPROVAL.
  approvalPolicy     ApprovalPolicy          @default(SELF_APPROVAL_ALLOWED)
  /// Display name (how the company is shown in CORE).
  name               String
  /// Registered legal name (Thai or any script, UTF-8).
  legalName          String?
  /// Thai 13-digit tax ID when given (format-checked only, not verified with the Revenue Department).
  taxId              String?
  /// Company registration number, when it differs from the tax ID.
  registrationNumber String?
  /// English name, when the company uses one (EP25).
  englishName        String?
  /// Main company phone, E.164 (EP25).
  phone              String?
  /// Public website, https:// or http:// only (EP25).
  website            String?
  /// Company contact address, when separate from the owner's account (EP25).
  contactEmail       String?
  /// Business type (EP25) — the same categories as sign-up; descriptive only, never authorization.
  industry           SignupIndustry?
  timezone           String                  @default("Asia/Bangkok")
  /// Company default language (EP25): invitation emails default to it.
  defaultLocale      AppLocale               @default(th)
  status             CompanyStatus           @default(PENDING_SUBSCRIPTION)
  onboardingStatus   CompanyOnboardingStatus @default(IN_PROGRESS)
  /// The account that created the company through onboarding (null for seeded data).
  createdById        String?
  createdBy          User?                   @relation("CompanyCreator", fields: [createdById], references: [id])
  /// Seeded demonstration data, never a real customer (EP23 demo seed).
  isDemo             Boolean                 @default(false)
  activatedAt        DateTime?
  suspendedAt        DateTime?
  closedAt           DateTime?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  departments        Department[]
  members            CompanyMember[]
  roles              Role[]
  invitations        Invitation[]
  branches           Branch[]
  subscriptions      Subscription[]
  auditLogs          AuditLog[]
  logo               CompanyLogo?
  /// EP28 operational master data (company-scoped canonical records).
  codeSequences      MasterCodeSequence[]
  customers          Customer[]
  suppliers          Supplier[]
  units              Unit[]
  itemCategories     ItemCategory[]
  items              Item[]
  /// EP29 document numbers (PR-YYYYMM-000001, …).
  documentSequences  DocumentSequence[]
  productionBoms     ProductionBom[]

  @@index([status])
  @@index([onboardingStatus])
  /// Platform Company Explorer: newest first, cursor by id (EP24.1).
  @@index([createdAt(sort: Desc), id(sort: Desc)])
}

/// Company logo (EP25). Stored in the database, not on disk: no file paths, no
/// public bucket, nothing executable. Raster images only (PNG / JPEG / WebP),
/// checked by their leading bytes, at most 256 KB. Served by the API with its
/// stored content type and nosniff. A future object store replaces `data`.
model CompanyLogo {
  companyId    String   @id
  company      Company  @relation(fields: [companyId], references: [id])
  contentType  String
  byteSize     Int
  /// SHA-256 of the bytes (base64url) — cache key / ETag.
  sha256       String
  data         Bytes
  uploadedById String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// The six standard CORE departments (EP24 canonical codes).
enum DepartmentCode {
  SALES
  OPERATIONS
  WAREHOUSE
  PURCHASING
  ACCOUNTING
  EXECUTIVE
}

/// A department the company has enabled (entitlement / configuration only — no
/// operational tables yet). The plan limits how many may be enabled. EP25:
/// disabling is soft (`isActive = false`): the row and its assignments stay.
model Department {
  id          String         @id @default(cuid())
  companyId   String
  company     Company        @relation(fields: [companyId], references: [id])
  code        DepartmentCode
  name        String
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  memberships Membership[]

  @@unique([companyId, code])
}

/// Which branches a membership may work in (EP26). Every membership that
/// existed before EP26 is ALL_BRANCHES — nobody is locked out by the upgrade.
/// The Company Owner is always ALL_BRANCHES (database CHECK).
enum BranchAccessScope {
  /// Every active branch of the company, including branches added later.
  ALL_BRANCHES
  /// Only the branches listed in MemberBranchAccess.
  SELECTED_BRANCHES
}

/// Customer-level role inside one company (EP23 foundation; enforced from EP25/EP26).
/// Never confused with platform roles: SYSTEM_ADMIN administers one company,
/// PLATFORM_ADMIN operates PDA BLISS CORE itself.
enum CompanyRole {
  COMPANY_OWNER
  SYSTEM_ADMIN
  EXECUTIVE
  DEPARTMENT_MANAGER
  DEPARTMENT_STAFF
  VIEWER
}

/// Membership in a company (EP25). Deactivation is soft: the record and its
/// history stay; the person simply loses access to the company.
enum CompanyMemberStatus {
  ACTIVE
  DEACTIVATED
}

/// A user's place in a company. Department access (Membership) comes on top (EP25 foundation).
model CompanyMember {
  id                              String                         @id @default(cuid())
  companyId                       String
  company                         Company                        @relation(fields: [companyId], references: [id])
  userId                          String
  user                            User                           @relation(fields: [userId], references: [id])
  role                            CompanyRole
  /// TRUE only for the COMPANY_OWNER (NULL otherwise): one owner per company,
  /// enforced by the database (unique + CHECK, EP24). The owner is always ACTIVE (CHECK, EP25).
  ownerSlot                       Boolean?
  status                          CompanyMemberStatus            @default(ACTIVE)
  /// Job title inside this company (set by company administration; not a permission).
  jobTitle                        String?
  deactivatedAt                   DateTime?
  /// Operational branch access (EP26). Administration authority does not depend on it.
  branchScope                     BranchAccessScope              @default(ALL_BRANCHES)
  createdAt                       DateTime                       @default(now())
  updatedAt                       DateTime                       @updatedAt
  branchAccess                    MemberBranchAccess[]
  /// Per-member exceptions to the role's operational permissions (EP27).
  permissionOverrides             MemberPermissionOverride[]
  /// EP29 purchase requests raised / decided / cancelled by this member.
  purchaseRequests                PurchaseRequest[]              @relation("PurchaseRequestRequester")
  approvedRequests                PurchaseRequest[]              @relation("PurchaseRequestApprover")
  rejectedRequests                PurchaseRequest[]              @relation("PurchaseRequestRejecter")
  cancelledRequests               PurchaseRequest[]              @relation("PurchaseRequestCanceller")
  /// EP30 purchase orders created / issued / cancelled, deposits confirmed / waived by this member.
  createdOrders                   PurchaseOrder[]                @relation("PurchaseOrderCreator")
  issuedOrders                    PurchaseOrder[]                @relation("PurchaseOrderIssuer")
  cancelledOrders                 PurchaseOrder[]                @relation("PurchaseOrderCanceller")
  confirmedDeposits               PurchaseOrder[]                @relation("PurchaseOrderDepositConfirmer")
  waivedDeposits                  PurchaseOrder[]                @relation("PurchaseOrderDepositWaiver")
  createdReceipts                 GoodsReceipt[]                 @relation("GoodsReceiptCreator")
  postedReceipts                  GoodsReceipt[]                 @relation("GoodsReceiptPoster")
  cancelledReceipts               GoodsReceipt[]                 @relation("GoodsReceiptCanceller")
  stockMovements                  StockMovement[]
  createdTransfers                InventoryTransfer[]            @relation("TransferCreator")
  createdSalesOrders              SalesOrder[]                   @relation("SalesOrderCreator")
  submittedSalesOrders            SalesOrder[]                   @relation("SalesOrderSubmitter")
  confirmedSalesOrders            SalesOrder[]                   @relation("SalesOrderConfirmer")
  cancelledSalesOrders            SalesOrder[]                   @relation("SalesOrderCanceller")
  createdAllocations              SalesAllocation[]              @relation("SalesAllocationCreator")
  releasedAllocations             SalesAllocation[]              @relation("SalesAllocationReleaser")
  salesPicksCreated               SalesPick[]                    @relation("SalesPickCreator")
  salesPicksStarted               SalesPick[]                    @relation("SalesPickStarter")
  salesPicksConfirmed             SalesPick[]                    @relation("SalesPickConfirmer")
  salesPicksCancelled             SalesPick[]                    @relation("SalesPickCanceller")
  salesPacksCreated               SalesPack[]                    @relation("SalesPackCreator")
  salesPacksPacked                SalesPack[]                    @relation("SalesPackPacker")
  salesPacksCancelled             SalesPack[]                    @relation("SalesPackCanceller")
  shipmentsCreated                SalesShipment[]                @relation("SalesShipmentCreator")
  shipmentsDispatched             SalesShipment[]                @relation("SalesShipmentDispatcher")
  shipmentsCancelled              SalesShipment[]                @relation("SalesShipmentCanceller")
  deliveryEvents                  SalesDeliveryEvent[]
  postedTransfers                 InventoryTransfer[]            @relation("TransferPoster")
  cancelledTransfers              InventoryTransfer[]            @relation("TransferCanceller")
  createdAdjustments              StockAdjustment[]              @relation("AdjustmentCreator")
  submittedAdjustments            StockAdjustment[]              @relation("AdjustmentSubmitter")
  approvedAdjustments             StockAdjustment[]              @relation("AdjustmentApprover")
  rejectedAdjustments             StockAdjustment[]              @relation("AdjustmentRejecter")
  cancelledAdjustments            StockAdjustment[]              @relation("AdjustmentCanceller")
  createdCounts                   CycleCount[]                   @relation("CountCreator")
  startedCounts                   CycleCount[]                   @relation("CountStarter")
  postedCounts                    CycleCount[]                   @relation("CountPoster")
  cancelledCounts                 CycleCount[]                   @relation("CountCanceller")
  countedLines                    CycleCountLine[]               @relation("CountLineCounter")
  productionBomsCreated           ProductionBom[]                @relation("ProductionBomCreator")
  productionBomsActivated         ProductionBom[]                @relation("ProductionBomActivator")
  productionBomsRetired           ProductionBom[]                @relation("ProductionBomRetirer")
  productionOrdersCreated         ProductionOrder[]              @relation("ProductionOrderCreator")
  productionOrdersSubmitted       ProductionOrder[]              @relation("ProductionOrderSubmitter")
  productionOrdersApproved        ProductionOrder[]              @relation("ProductionOrderApprover")
  productionOrdersReleased        ProductionOrder[]              @relation("ProductionOrderReleaser")
  productionOrdersRejected        ProductionOrder[]              @relation("ProductionOrderRejecter")
  productionOrdersCancelled       ProductionOrder[]              @relation("ProductionOrderCanceller")
  productionOrdersStarted         ProductionOrder[]              @relation("ProductionOrderStarter")
  productionAllocationsCreated    ProductionMaterialAllocation[] @relation("ProductionAllocationCreator")
  productionAllocationsReleased   ProductionMaterialAllocation[] @relation("ProductionAllocationReleaser")
  materialIssuesCreated           ProductionMaterialIssue[]      @relation("MaterialIssueCreator")
  materialIssuesPosted            ProductionMaterialIssue[]      @relation("MaterialIssuePoster")
  materialIssuesCancelled         ProductionMaterialIssue[]      @relation("MaterialIssueCanceller")
  materialUsageRecorded           ProductionMaterialUsage[]      @relation("MaterialUsageRecorder")
  /// EP38
  productionOrdersReviewRequested ProductionOrder[]              @relation("ProductionOrderReviewRequester")
  productionOrdersCompleted       ProductionOrder[]              @relation("ProductionOrderCompleter")
  outputReportsCreated            ProductionOutputReport[]       @relation("OutputReportCreator")
  outputReportsSubmitted          ProductionOutputReport[]       @relation("OutputReportSubmitter")
  outputReportsReviewed           ProductionOutputReport[]       @relation("OutputReportReviewer")
  outputReportsCancelled          ProductionOutputReport[]       @relation("OutputReportCanceller")
  fgReceiptsCreated               ProductionGoodsReceipt[]       @relation("FgReceiptCreator")
  fgReceiptsPosted                ProductionGoodsReceipt[]       @relation("FgReceiptPoster")
  fgReceiptsCancelled             ProductionGoodsReceipt[]       @relation("FgReceiptCanceller")
  fgReceiptsReversed              ProductionGoodsReceipt[]       @relation("FgReceiptReverser")

  /// v1 policy: one company per user (no company switching).
  @@unique([userId])
  @@unique([companyId, ownerSlot])
  /// Target of MemberBranchAccess's company-bound foreign key (EP26).
  @@unique([id, companyId])
  @@index([companyId])
}

/// Effect of a per-member permission exception (EP27). DENY beats every ALLOW.
enum PermissionEffect {
  ALLOW
  DENY
}

/// A per-member exception to the role's default operational permissions
/// (EP27). Only codes of the canonical catalog (backend/src/permissions/
/// catalog.ts) are accepted — the API validates, and a database CHECK lists
/// the operational codes. Company-administration permissions follow the role
/// and never appear here; the owner has none. The foreign key carries the
/// company id, so an exception can never point into another company. An
/// exception for a department that is later disabled stays (inactive) and
/// returns with the department.
model MemberPermissionOverride {
  id          String           @id @default(cuid())
  companyId   String
  memberId    String
  member      CompanyMember    @relation(fields: [memberId, companyId], references: [id, companyId], onDelete: Cascade)
  permission  String
  effect      PermissionEffect
  createdById String?
  updatedById String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([memberId, permission])
  @@index([companyId])
}

/// One branch a SELECTED_BRANCHES membership may work in (EP26). Both foreign
/// keys carry the company id, so the database refuses a grant that would mix
/// companies; a branch appears at most once per membership.
model MemberBranchAccess {
  id          String        @id @default(cuid())
  companyId   String
  memberId    String
  member      CompanyMember @relation(fields: [memberId, companyId], references: [id, companyId], onDelete: Cascade)
  branchId    String
  branch      Branch        @relation(fields: [branchId, companyId], references: [id, companyId])
  grantedById String?
  createdAt   DateTime      @default(now())

  @@unique([memberId, branchId])
  @@index([branchId])
  @@index([companyId])
}

// ---------------------------------------------------------------------------
// Branches (EP24). Every company has exactly one Head Office (code 00000).
// v1: members see every branch of their company; branch scoping comes later.
// ---------------------------------------------------------------------------

enum BranchType {
  HEAD_OFFICE
  BRANCH
}

enum BranchStatus {
  ACTIVE
  /// Closed permanently (platform-controlled; not used by customers in EP25).
  CLOSED
  /// Deactivated by the company (EP25); can be reactivated. Never the Head Office.
  INACTIVE
}

model Branch {
  id                    String                         @id @default(cuid())
  companyId             String
  company               Company                        @relation(fields: [companyId], references: [id])
  /// Stable 5-digit code, unique per company; the Head Office is 00000.
  code                  String
  name                  String
  type                  BranchType
  status                BranchStatus                   @default(ACTIVE)
  /// TRUE only for the Head Office (NULL otherwise): at most one per company in
  /// the database; onboarding creates it in the same transaction as the company.
  headOfficeSlot        Boolean?
  addressLine1          String
  addressLine2          String?
  /// Sub-district / tambon (Thailand) or locality.
  subdistrict           String?
  /// District / amphoe / khet, or city.
  district              String?
  /// Province / state / region.
  province              String
  postalCode            String
  /// ISO 3166-1 alpha-2.
  countryCode           String                         @default("TH")
  phone                 String?
  deactivatedAt         DateTime?
  createdAt             DateTime                       @default(now())
  updatedAt             DateTime                       @updatedAt
  /// Sessions working in this branch (EP25 branch context).
  sessions              Session[]
  /// Memberships granted this branch specifically (EP26).
  memberAccess          MemberBranchAccess[]
  /// Physical locations inside this branch (EP28).
  locations             WarehouseLocation[]
  /// Purchase requests raised in this branch (EP29).
  purchaseRequests      PurchaseRequest[]
  /// Purchase orders of this branch (EP30; always the branch of their requests).
  purchaseOrders        PurchaseOrder[]
  salesOrders           SalesOrder[]
  salesAllocations      SalesAllocation[]
  salesPicks            SalesPick[]
  salesPacks            SalesPack[]
  salesShipments        SalesShipment[]
  goodsReceipts         GoodsReceipt[]
  stockMovements        StockMovement[]
  stockBalances         StockBalance[]
  transfers             InventoryTransfer[]
  adjustments           StockAdjustment[]
  cycleCounts           CycleCount[]
  productionOrders      ProductionOrder[]
  productionAllocations ProductionMaterialAllocation[]
  materialIssues        ProductionMaterialIssue[]
  outputReports         ProductionOutputReport[]
  finishedGoodsReceipts ProductionGoodsReceipt[]

  @@unique([companyId, code])
  @@unique([companyId, headOfficeSlot])
  /// Target of MemberBranchAccess's company-bound foreign key (EP26).
  @@unique([id, companyId])
  @@index([companyId])
}

// ---------------------------------------------------------------------------
// Subscriptions (EP24 foundation — no payment processing)
// ---------------------------------------------------------------------------

enum PlanCode {
  STARTER
  BUSINESS
  PROFESSIONAL
  ENTERPRISE
}

enum BillingCycle {
  MONTHLY
  ANNUAL
}

enum SubscriptionStatus {
  /// Created by onboarding; not paid and not active. Payment / manual activation pending.
  PENDING
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELED
  EXPIRED
}

/// One subscription = one company, every branch included. The plan definition is
/// snapshotted at creation so later catalog changes never rewrite its meaning.
model Subscription {
  id                     String             @id @default(cuid())
  companyId              String
  company                Company            @relation(fields: [companyId], references: [id])
  plan                   PlanCode
  status                 SubscriptionStatus @default(PENDING)
  billingCycle           BillingCycle       @default(MONTHLY)
  /// PLAN_CATALOG_VERSION the snapshot below was taken from.
  catalogVersion         Int
  /// THB per month at creation; NULL for a quotation plan (Enterprise).
  monthlyPriceThb        Int?
  /// The plan's entitlements at creation (limits, storage, API, …), from the catalog.
  entitlements           Json
  /// TRUE for the company's current subscription (NULL once canceled / expired).
  currentSlot            Boolean?
  startsAt               DateTime?
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean            @default(false)
  activatedAt            DateTime?
  endedAt                DateTime?
  /// Future payment provider references (none in EP24).
  paymentProvider        String?
  providerSubscriptionId String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  @@unique([companyId, currentSlot])
  @@index([companyId, status])
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

enum UserStatus {
  /// Self-registered; the email address is not verified yet. No authenticated access.
  PENDING_VERIFICATION
  ACTIVE
  /// Temporarily blocked by the platform or the company. Sessions are revoked.
  SUSPENDED
  /// Permanently closed.
  DISABLED
}

enum AppLocale {
  th
  en
  zh_CN
}

/// Self-described work area of the person (EP24.1). Profile information only —
/// it never grants a role, a department or any permission.
enum JobFunction {
  OWNER
  EXECUTIVE
  ACCOUNTING
  PURCHASING
  SALES
  OPERATIONS
  WAREHOUSE
  IT
  OTHER
}

/// Business context a person gives at sign-up (EP24.1) — lead information for
/// PDA BLISS. It is NOT the company record (that is created in onboarding) and
/// it never grants anything.
enum SignupIndustry {
  DISTRIBUTION
  SERVICES
  PROJECTS
  RETAIL
  PROPERTY
  MANUFACTURING
  OTHER
}

enum SignupTeamSize {
  SIZE_1_10
  SIZE_11_50
  SIZE_51_200
  SIZE_201_500
  SIZE_500_PLUS
}

enum ContactPreference {
  EMAIL
  PHONE
  LINE
}

enum SignupInterest {
  SALES
  WAREHOUSE
  PURCHASING
  OPERATIONS
  ACCOUNTING_WORKFLOW
  EXECUTIVE_VISIBILITY
  FULL_ORGANIZATION
}

model AccountSignupContext {
  userId           String            @id
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// The company the person says they represent (free text; not verified, not a Company row).
  companyName      String
  industry         SignupIndustry
  teamSize         SignupTeamSize
  preferredContact ContactPreference @default(EMAIL)
  /// LINE ID when LINE is the preferred contact.
  lineId           String?
  interests        SignupInterest[]
  /// Optional needs / pain points in the person's own words.
  note             String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

/// One human = one account, across the whole platform.
model User {
  id               String                   @id @default(cuid())
  /// As entered (trimmed), for display and for sending mail.
  email            String
  /// Lower-cased, trimmed, NFC — the identity key. Unique.
  emailNormalized  String                   @unique
  /// The person's full name (EP24.1: required at registration; NULL only for older accounts).
  fullName         String?
  /// Contact phone, normalized to E.164 (e.g. +66812345678). Profile data — not an MFA factor.
  phone            String?
  /// Self-described work area; never an authorization input.
  jobFunction      JobFunction?
  locale           AppLocale                @default(th)
  status           UserStatus               @default(PENDING_VERIFICATION)
  emailVerifiedAt  DateTime?
  /// Package chosen before company creation (lower-case plan id; onboarding intent — no subscription).
  planIntent       String?
  /// When the package was last chosen in the Account Portal (EP24).
  planSelectedAt   DateTime?
  lastLoginAt      DateTime?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  credential       UserCredential?
  platformRole     PlatformRoleAssignment?  @relation("PlatformRoleHolder")
  grantedRoles     PlatformRoleAssignment[] @relation("PlatformRoleGrantor")
  companyMember    CompanyMember?
  memberships      Membership[]
  sessions         Session[]
  trustedDevices   TrustedDevice[]
  otpChallenges    OtpChallenge[]
  emailTokens      EmailVerificationToken[]
  resetTokens      PasswordResetToken[]
  invitationsSent  Invitation[]             @relation("InvitationInviter")
  invitationsUsed  Invitation[]             @relation("InvitationAcceptor")
  authEvents       AuthAuditEvent[]         @relation("AuthEventUser")
  actedEvents      AuthAuditEvent[]         @relation("AuthEventActor")
  auditLogs        AuditLog[]
  companiesCreated Company[]                @relation("CompanyCreator")
  signupContext    AccountSignupContext?

  @@index([status])
}

/// Password credential, separate from the profile so it is never selected by accident.
model UserCredential {
  userId            String   @id
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// PHC string (algorithm and cost parameters included) — upgraded on login when parameters change.
  passwordHash      String
  passwordChangedAt DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

enum PlatformRole {
  /// The highest PDA BLISS CORE authority. Exactly one, bootstrapped from PLATFORM_OWNER_EMAIL.
  PLATFORM_OWNER
  /// Operational PDA BLISS administrator, below the owner.
  PLATFORM_ADMIN
}

/// Platform-level authority (not a department, not a company role).
model PlatformRoleAssignment {
  id          String       @id @default(cuid())
  userId      String       @unique
  user        User         @relation("PlatformRoleHolder", fields: [userId], references: [id])
  role        PlatformRole
  /// TRUE only for PLATFORM_OWNER (NULL otherwise). Unique, so the database
  /// itself refuses a second owner.
  ownerSlot   Boolean?     @unique
  grantedById String?
  grantedBy   User?        @relation("PlatformRoleGrantor", fields: [grantedById], references: [id])
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

// ---------------------------------------------------------------------------
// Sessions and devices
// ---------------------------------------------------------------------------

enum SessionRevokeReason {
  LOGOUT
  LOGOUT_ALL
  REVOKED_BY_USER
  PASSWORD_RESET
  ACCOUNT_SUSPENDED
  ROLE_CHANGED
  ROTATED
}

/// Server-side session. The browser holds a random token in an HttpOnly cookie;
/// only its SHA-256 hash is stored here.
model Session {
  id                 String               @id @default(cuid())
  userId             String
  user               User                 @relation(fields: [userId], references: [id])
  tokenHash          String               @unique
  /// The token before the last rotation, accepted briefly so in-flight requests survive it.
  previousTokenHash  String?              @unique
  previousValidUntil DateTime?
  /// Privileged (platform) sessions get shorter lifetimes and stricter step-up.
  privileged         Boolean              @default(false)
  createdAt          DateTime             @default(now())
  lastSeenAt         DateTime             @default(now())
  rotatedAt          DateTime             @default(now())
  idleExpiresAt      DateTime
  absoluteExpiresAt  DateTime
  /// Last successful one-time-code check in this session (login or step-up).
  stepUpAt           DateTime?
  revokedAt          DateTime?
  revokeReason       SessionRevokeReason?
  ipAddress          String?
  userAgent          String?
  /// EP25 branch context: the branch this session works in, chosen through
  /// /company/context/branch and re-validated on every operational request.
  branchId           String?
  branch             Branch?              @relation(fields: [branchId], references: [id], onDelete: SetNull)
  branchSelectedAt   DateTime?

  @@index([userId, revokedAt])
  @@index([absoluteExpiresAt])
}

/// A browser that completed an email one-time code ("new device" check). Customer
/// accounts only — platform accounts are challenged on every sign-in.
model TrustedDevice {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  tokenHash  String    @unique
  userAgent  String?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?

  @@index([userId])
}

// ---------------------------------------------------------------------------
// One-time codes and email tokens
// ---------------------------------------------------------------------------

enum OtpPurpose {
  LOGIN
  STEP_UP
}

enum OtpStatus {
  PENDING
  VERIFIED
  /// Replaced by a newer challenge for the same user and purpose.
  SUPERSEDED
  /// Too many wrong codes.
  LOCKED
  /// Invalidated by a security change (e.g. password reset).
  CANCELLED
}

/// Email one-time code. The code is stored as an HMAC (keyed by AUTH_SECRET).
model OtpChallenge {
  id          String     @id @default(cuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id])
  purpose     OtpPurpose
  status      OtpStatus  @default(PENDING)
  codeHash    String
  /// LOGIN: hash of the browser-bound pending-login cookie. STEP_UP: unused.
  bindingHash String?
  /// STEP_UP: the session being elevated.
  sessionId   String?
  attempts    Int        @default(0)
  maxAttempts Int        @default(5)
  sendCount   Int        @default(1)
  lastSentAt  DateTime   @default(now())
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([userId, purpose, status])
  @@index([createdAt])
}

model EmailVerificationToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  tokenHash  String    @unique
  expiresAt  DateTime
  usedAt     DateTime?
  /// Set when a newer token replaced this one.
  replacedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, createdAt])
}

model PasswordResetToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  tokenHash  String    @unique
  expiresAt  DateTime
  usedAt     DateTime?
  replacedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, createdAt])
}

// ---------------------------------------------------------------------------
// Invitations (foundation for the Company Control Center)
// ---------------------------------------------------------------------------

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
}

model Invitation {
  id              String            @id @default(cuid())
  companyId       String
  company         Company           @relation(fields: [companyId], references: [id])
  /// The invitee address, bound: only an account with this normalized email can accept.
  email           String
  emailNormalized String
  role            CompanyRole
  /// Language of the invitation email (EP25; NULL for older invitations).
  locale          AppLocale?
  tokenHash       String            @unique
  status          InvitationStatus  @default(PENDING)
  invitedById     String
  invitedBy       User              @relation("InvitationInviter", fields: [invitedById], references: [id])
  expiresAt       DateTime
  acceptedAt      DateTime?
  acceptedById    String?
  acceptedBy      User?             @relation("InvitationAcceptor", fields: [acceptedById], references: [id])
  revokedAt       DateTime?
  /// EP26 intent, re-validated at acceptance: departments to assign (only those
  /// still enabled are applied) and the branch access to give.
  departments     DepartmentCode[]  @default([])
  branchScope     BranchAccessScope @default(ALL_BRANCHES)
  /// Branch ids for SELECTED_BRANCHES (only active branches of the company are applied).
  branchIds       String[]          @default([])
  /// Set on the replacement when an invitation is resent (the old row is revoked).
  resentFromId    String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([companyId, status])
  @@index([companyId, createdAt])
  @@index([emailNormalized])
}

// ---------------------------------------------------------------------------
// Audit
// ---------------------------------------------------------------------------

enum AuthEventType {
  REGISTER
  REGISTER_EXISTING_EMAIL
  EMAIL_VERIFICATION_SENT
  EMAIL_VERIFIED
  LOGIN_SUCCESS
  LOGIN_FAILURE
  OTP_SENT
  OTP_SUCCESS
  OTP_FAILURE
  STEP_UP_SUCCESS
  PASSWORD_RESET_REQUEST
  PASSWORD_RESET_SUCCESS
  LOGOUT
  LOGOUT_ALL
  SESSION_REVOKED
  INVITATION_CREATED
  INVITATION_ACCEPTED
  INVITATION_REVOKED
  PLATFORM_ROLE_GRANTED
  PLATFORM_ROLE_REVOKED
  ACCOUNT_SUSPENDED
  ACCOUNT_REACTIVATED
  PLATFORM_BOOTSTRAP
  /// Development only: a seeded demo customer signed in without the emailed code.
  DEMO_AUTH_BYPASS
}

/// Security-relevant authentication events. Append-only; never holds secrets.
model AuthAuditEvent {
  id          String        @id @default(cuid())
  type        AuthEventType
  /// The account the event is about (when known).
  userId      String?
  user        User?         @relation("AuthEventUser", fields: [userId], references: [id])
  /// Who performed it, when different from the subject (platform actions).
  actorId     String?
  actor       User?         @relation("AuthEventActor", fields: [actorId], references: [id])
  sessionId   String?
  /// HMAC of the normalized email for attempts on unknown or unauthenticated
  /// accounts — lets throttling count attempts without storing the address.
  subjectHash String?
  ipAddress   String?
  userAgent   String?
  requestId   String?
  /// Small, non-secret context (e.g. a coarse failure reason).
  metadata    Json?
  occurredAt  DateTime      @default(now())

  @@index([userId, occurredAt])
  @@index([subjectHash, type, occurredAt])
  @@index([type, occurredAt])
}

// ---------------------------------------------------------------------------
// Department access (EP00 foundation; used from EP26)
// ---------------------------------------------------------------------------

/// A user's access inside a department (EP25: the department assignment).
/// One human = one User; working in several departments means several rows,
/// never several accounts. The optional department Role (fine-grained
/// permissions) arrives with EP27.
model Membership {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id])
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  roleId       String?
  role         Role?      @relation(fields: [roleId], references: [id])
  isPrimary    Boolean    @default(false)
  createdAt    DateTime   @default(now())

  @@unique([userId, departmentId])
  @@index([departmentId])
}

model Role {
  id          String           @id @default(cuid())
  companyId   String
  company     Company          @relation(fields: [companyId], references: [id])
  code        String
  name        String
  isSystem    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  permissions RolePermission[]
  memberships Membership[]

  @@unique([companyId, code])
}

/// Permission codes are defined in code (e.g. "purchasing.pr.approve").
model Permission {
  id          String           @id @default(cuid())
  code        String           @unique
  description String
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id])
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
}

/// Append-only audit trail with before/after field changes (business entities).
/// EP24: company onboarding and subscription events (see src/company/audit.ts).
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id])
  /// The company the action concerns, when there is one.
  companyId  String?
  company    Company? @relation(fields: [companyId], references: [id])
  action     String
  entityType String
  entityId   String
  requestId  String
  reason     String?
  changes    Json
  occurredAt DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId, occurredAt])
  @@index([companyId, occurredAt])
}

// ---------------------------------------------------------------------------
// Operational master data (EP28) — docs/OPERATIONAL_MASTER_DATA.md
//
// ONE canonical record per business identity, shared by every department:
// Sales, Purchasing, Warehouse, Operations and Accounting reference these ids
// and never keep their own copies. Customers, suppliers, items, units and
// categories belong to exactly one Company; warehouse locations belong to one
// Branch of that company. Every relation carries the company id in its
// foreign key, so a record can never point into another company.
//
// Nothing is hard-deleted: records are deactivated (INACTIVE) and stay
// identifiable for history. Codes are business identifiers, unique per
// company (per branch for locations) and immutable once created. No price,
// cost, margin, payment term or balance lives here — identity only.
// ---------------------------------------------------------------------------

/// Lifecycle of a master record. INACTIVE refuses new use (future workflows)
/// but keeps the record readable and historically identifiable.
enum MasterStatus {
  ACTIVE
  INACTIVE
}

/// Per-company counters behind generated codes (CUS-000001, FG-000001, …).
/// Incremented with one atomic upsert inside the transaction that creates the
/// record, so concurrent creates never share a number and a failed create
/// leaves no gap.
model MasterCodeSequence {
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  /// The code prefix, e.g. CUS, SUP, FG, RM.
  prefix    String
  lastValue Int      @default(0)
  updatedAt DateTime @updatedAt

  @@id([companyId, prefix])
}

enum CustomerKind {
  INDIVIDUAL
  BUSINESS
}

/// The canonical customer (EP28). Identity and contact only — no credit,
/// receivable, aging or revenue figures (those are workflow / reporting data).
model Customer {
  id              String       @id @default(cuid())
  companyId       String
  company         Company      @relation(fields: [companyId], references: [id])
  /// Company-unique, immutable (generated CUS-000001 or entered on creation).
  code            String
  kind            CustomerKind @default(BUSINESS)
  /// Display / trading name.
  name            String
  legalName       String?
  /// Normalized (no spaces or dashes, upper case). Optional; not assumed Thai.
  taxId           String?
  /// Tax branch text, e.g. "สำนักงานใหญ่" or "00001".
  taxBranch       String?
  contactName     String?
  /// E.164 when given.
  phone           String?
  email           String?
  lineId          String?
  billingAddress  String?
  shippingAddress String?
  notes           String?
  status          MasterStatus @default(ACTIVE)
  deactivatedAt   DateTime?
  createdById     String?
  updatedById     String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  /// EP33
  salesOrders SalesOrder[]

  @@unique([companyId, code])
  /// Target of company-bound foreign keys from future documents.
  @@unique([id, companyId])
  @@index([companyId, status])
  @@index([companyId, name])
}

/// The canonical supplier (EP28) — GENERAL identity only. Financial terms
/// (payment terms, bank accounts, prices) belong to future Purchasing /
/// Accounting records that Warehouse never receives; none is stored here.
model Supplier {
  id             String          @id @default(cuid())
  companyId      String
  company        Company         @relation(fields: [companyId], references: [id])
  code           String
  name           String
  legalName      String?
  taxId          String?
  taxBranch      String?
  contactName    String?
  phone          String?
  email          String?
  address        String?
  notes          String?
  status         MasterStatus    @default(ACTIVE)
  deactivatedAt  DateTime?
  createdById    String?
  updatedById    String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  /// EP30: purchase orders placed with this supplier (identity snapshotted on each).
  purchaseOrders PurchaseOrder[]
  goodsReceipts  GoodsReceipt[]

  @@unique([companyId, code])
  @@unique([id, companyId])
  @@index([companyId, status])
  @@index([companyId, name])
}

/// A unit of measure (PCS, KG, L, BOX, …). `precision` is the number of
/// decimal places a quantity in this unit may carry (0 = whole numbers);
/// future quantities are exact decimals, never floating point.
model Unit {
  id                  String                    @id @default(cuid())
  companyId           String
  company             Company                   @relation(fields: [companyId], references: [id])
  code                String
  name                String
  symbol              String?
  precision           Int                       @default(0)
  status              MasterStatus              @default(ACTIVE)
  deactivatedAt       DateTime?
  createdById         String?
  updatedById         String?
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  items               Item[]
  /// EP29: request lines counted in this unit.
  requestLines        PurchaseRequestLine[]
  /// EP30: order lines counted in this unit.
  orderLines          PurchaseOrderLine[]
  receiptLines        GoodsReceiptLine[]
  salesOrderLines     SalesOrderLine[]
  /// EP36 production planning.
  productionBoms      ProductionBom[]           @relation("ProductionBomUnit")
  productionBomLines  ProductionBomLine[]       @relation("ProductionBomLineUnit")
  productionOrders    ProductionOrder[]         @relation("ProductionOrderUnit")
  productionMaterials ProductionOrderMaterial[] @relation("ProductionOrderMaterialUnit")

  @@unique([companyId, code])
  @@unique([id, companyId])
  @@index([companyId, status])
}

/// A flat item category (v1: no hierarchy).
model ItemCategory {
  id            String       @id @default(cuid())
  companyId     String
  company       Company      @relation(fields: [companyId], references: [id])
  code          String
  name          String
  description   String?
  status        MasterStatus @default(ACTIVE)
  deactivatedAt DateTime?
  createdById   String?
  updatedById   String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  items         Item[]

  @@unique([companyId, code])
  @@unique([id, companyId])
  @@index([companyId, status])
}

/// What an item is. NON_STOCK items (services, fees) never track inventory.
enum ItemType {
  FINISHED_GOOD
  RAW_MATERIAL
  PACKAGING
  CONSUMABLE
  NON_STOCK
}

/// Whether future stock of an item carries a lot / an expiry date.
enum TrackingRequirement {
  NONE
  OPTIONAL
  REQUIRED
}

/// The canonical item (EP28) — the one identity Sales, Purchasing, Warehouse
/// and Operations reference. Identity and tracking requirements only: no
/// quantity, cost, price or margin. Tracking rules (database CHECKs):
/// NON_STOCK ⇒ not inventory tracked; not tracked ⇒ no lot / expiry; expiry is
/// recorded per lot, so expiry tracking needs lot tracking at least as strict.
/// Base unit and tracking change only through the structure policy
/// (src/master-data/policy.ts) — the point future Warehouse locks.
model Item {
  id                    String                         @id @default(cuid())
  companyId             String
  company               Company                        @relation(fields: [companyId], references: [id])
  /// Company-unique, immutable (generated FG-000001 … or entered on creation).
  code                  String
  /// Fixed at creation (it chose the code prefix).
  type                  ItemType
  name                  String
  description           String?
  /// Internal reference / SKU, company-unique when given.
  sku                   String?
  /// Barcode (GTIN / EAN / internal), company-unique when given. No scanning yet.
  barcode               String?
  baseUnitId            String
  baseUnit              Unit                           @relation(fields: [baseUnitId, companyId], references: [id, companyId])
  categoryId            String?
  category              ItemCategory?                  @relation(fields: [categoryId, companyId], references: [id, companyId])
  inventoryTracked      Boolean                        @default(true)
  lotTracking           TrackingRequirement            @default(NONE)
  expiryTracking        TrackingRequirement            @default(NONE)
  status                MasterStatus                   @default(ACTIVE)
  deactivatedAt         DateTime?
  createdById           String?
  updatedById           String?
  createdAt             DateTime                       @default(now())
  updatedAt             DateTime                       @updatedAt
  /// EP29: request lines that name this item (canonical reference).
  requestLines          PurchaseRequestLine[]
  /// EP30: order lines that name this item.
  orderLines            PurchaseOrderLine[]
  /// EP31: receipt lines, lots and stock of this item.
  receiptLines          GoodsReceiptLine[]
  lots                  InventoryLot[]
  stockMovements        StockMovement[]
  stockBalances         StockBalance[]
  transferLines         InventoryTransferLine[]
  adjustmentLines       StockAdjustmentLine[]
  cycleCounts           CycleCount[]
  countLines            CycleCountLine[]
  salesOrderLines       SalesOrderLine[]
  salesAllocations      SalesAllocation[]
  salesPickLines        SalesPickLine[]
  /// EP36: BOMs that make this item, BOM lines and orders that use it.
  productionBoms        ProductionBom[]                @relation("ProductionBomOutput")
  productionBomLines    ProductionBomLine[]            @relation("ProductionBomMaterial")
  productionOrders      ProductionOrder[]              @relation("ProductionOrderOutput")
  productionMaterials   ProductionOrderMaterial[]      @relation("ProductionOrderMaterial")
  productionAllocations ProductionMaterialAllocation[] @relation("ProductionAllocationItem")
  materialIssueLines    ProductionMaterialIssueLine[]  @relation("ProductionIssueLineItem")
  /// EP38
  fgReceiptLines        ProductionGoodsReceiptLine[]   @relation("FgReceiptLineItem")

  @@unique([companyId, code])
  @@unique([companyId, sku])
  @@unique([companyId, barcode])
  @@unique([id, companyId])
  @@index([companyId, status])
  @@index([companyId, type])
  @@index([companyId, name])
  @@index([categoryId])
  @@index([baseUnitId])
}

/// A physical place inside one branch (MAIN, RECEIVING, RACK-A, A-01, …).
/// Code unique within the branch. Optional parent in the same branch (the
/// parent foreign key carries the branch id; the service refuses cycles and
/// depth beyond 4). At most one default location per branch. No stock here.
model WarehouseLocation {
  id                    String                         @id @default(cuid())
  companyId             String
  branchId              String
  branch                Branch                         @relation(fields: [branchId, companyId], references: [id, companyId])
  code                  String
  name                  String
  description           String?
  parentId              String?
  parent                WarehouseLocation?             @relation("LocationTree", fields: [parentId, branchId], references: [id, branchId])
  children              WarehouseLocation[]            @relation("LocationTree")
  /// TRUE for the branch's default operational location (NULL otherwise).
  defaultSlot           Boolean?
  status                MasterStatus                   @default(ACTIVE)
  deactivatedAt         DateTime?
  createdById           String?
  updatedById           String?
  createdAt             DateTime                       @default(now())
  updatedAt             DateTime                       @updatedAt
  /// EP31: receipts defaulting here, receipt allocations and stock in this location.
  defaultForReceipts    GoodsReceipt[]                 @relation("GoodsReceiptDefaultLocation")
  allocations           GoodsReceiptAllocation[]
  stockMovements        StockMovement[]
  stockBalances         StockBalance[]
  /// EP32: transfers from / to here, adjustment lines, count scopes and lines.
  transfersOut          InventoryTransfer[]            @relation("TransferSource")
  transfersIn           InventoryTransfer[]            @relation("TransferDestination")
  adjustmentLines       StockAdjustmentLine[]
  countScopes           CycleCountLocation[]
  countLines            CycleCountLine[]
  /// EP34: stock reserved here for sales order lines.
  salesAllocations      SalesAllocation[]
  salesPickLines        SalesPickLine[]
  /// EP37: production reservations and material issue lines here.
  productionAllocations ProductionMaterialAllocation[] @relation("ProductionAllocationLocation")
  materialIssueLines    ProductionMaterialIssueLine[]  @relation("ProductionIssueLineLocation")
  /// EP38: finished goods receipt lines into this location.
  fgReceiptLines        ProductionGoodsReceiptLine[]   @relation("FgReceiptLineLocation")

  @@unique([branchId, code])
  @@unique([branchId, defaultSlot])
  @@unique([id, branchId])
  @@unique([id, companyId])
  @@index([companyId, status])
  @@index([parentId])
}

// ---------------------------------------------------------------------------
// Purchase requests (EP29) — docs/PURCHASING_REQUEST.md
//
// The first operational document: a department asks for goods, materials or
// services BEFORE any purchase order exists. A request belongs to one company
// and one branch, is raised from one department by one member, and moves
// DRAFT → SUBMITTED → APPROVED | REJECTED, or → CANCELLED where allowed — only
// through the transition policy (src/purchasing/transitions.ts). Lines ask for
// a quantity of a canonical item (with snapshots of its code, name and unit)
// or describe a one-off need. No price, cost, supplier or tax: commercial
// terms belong to the future purchase order.
// ---------------------------------------------------------------------------

/// Per-company counters behind document numbers (`PR:202610` → PR-202610-000001).
/// Incremented atomically in the creating transaction, like MasterCodeSequence.
model DocumentSequence {
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  /// Document type and period, e.g. PR:202610.
  key       String
  lastValue Int      @default(0)
  updatedAt DateTime @updatedAt

  @@id([companyId, key])
}

enum PurchaseRequestStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  CANCELLED
}

enum PurchaseRequestLineType {
  /// A canonical Item in one of its units (snapshots kept for history).
  ITEM
  /// A described one-off need (a service, a repair) — no fake Item required.
  NON_ITEM
}

model PurchaseRequest {
  id                    String                @id @default(cuid())
  companyId             String
  /// The branch the request is raised in (the requester's selected branch).
  branchId              String
  branch                Branch                @relation(fields: [branchId, companyId], references: [id, companyId])
  /// PR-YYYYMM-NNNNNN: company-unique, immutable, from DocumentSequence.
  number                String
  /// The department the need comes from (canonical code; labels localize at display).
  department            DepartmentCode
  requesterMemberId     String
  requester             CompanyMember         @relation("PurchaseRequestRequester", fields: [requesterMemberId, companyId], references: [id, companyId])
  status                PurchaseRequestStatus @default(DRAFT)
  /// The calendar day the request was raised (company time zone).
  requestDate           DateTime              @db.Date
  needByDate            DateTime?             @db.Date
  /// Why it is needed, as written (required to submit).
  purpose               String?
  /// Next line number to hand out; numbers are never reused.
  lineCounter           Int                   @default(0)
  /// Taken on submit so the document stays readable if the branch or person is renamed.
  branchCodeSnapshot    String?
  branchNameSnapshot    String?
  requesterNameSnapshot String?
  submittedAt           DateTime?
  approvedAt            DateTime?
  approvedByMemberId    String?
  approvedBy            CompanyMember?        @relation("PurchaseRequestApprover", fields: [approvedByMemberId, companyId], references: [id, companyId])
  rejectedAt            DateTime?
  rejectedByMemberId    String?
  rejectedBy            CompanyMember?        @relation("PurchaseRequestRejecter", fields: [rejectedByMemberId, companyId], references: [id, companyId])
  rejectionReason       String?
  cancelledAt           DateTime?
  cancelledByMemberId   String?
  cancelledBy           CompanyMember?        @relation("PurchaseRequestCanceller", fields: [cancelledByMemberId, companyId], references: [id, companyId])
  cancellationReason    String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  lines                 PurchaseRequestLine[]
  /// EP30: order lines placed against this request.
  orderLines            PurchaseOrderLine[]

  @@unique([companyId, number])
  /// Target of company-bound foreign keys (lines; future purchase orders).
  @@unique([id, companyId])
  /// EP30: order lines reference (request, branch, company) — an order line can
  /// only point at a request of its own order's branch.
  @@unique([id, branchId, companyId])
  @@index([companyId, status, updatedAt])
  @@index([companyId, branchId, status])
  @@index([companyId, requesterMemberId])
  @@index([companyId, department, status])
}

model PurchaseRequestLine {
  id                String                  @id @default(cuid())
  companyId         String
  purchaseRequestId String
  request           PurchaseRequest         @relation(fields: [purchaseRequestId, companyId], references: [id, companyId], onDelete: Cascade)
  /// 1, 2, 3 … within the request; stable (never reused after a removal).
  lineNo            Int
  type              PurchaseRequestLineType
  itemId            String?
  item              Item?                   @relation(fields: [itemId, companyId], references: [id, companyId])
  /// Snapshots of the item (server-derived; never from the client).
  itemCode          String?
  itemName          String?
  /// What a NON_ITEM line asks for.
  description       String?
  unitId            String?
  unit              Unit?                   @relation(fields: [unitId, companyId], references: [id, companyId])
  /// Unit snapshots (or the free unit text of a NON_ITEM line).
  unitCode          String?
  unitName          String?
  /// Exact decimal, > 0, within the unit's precision. Never floating point.
  quantity          Decimal                 @db.Decimal(18, 6)
  note              String?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  /// EP30: order lines placed against this request line.
  orderLines        PurchaseOrderLine[]

  @@unique([purchaseRequestId, lineNo])
  /// Target of company-bound foreign keys from future purchase-order lines.
  @@unique([id, companyId])
  /// EP30: an order line names (request line, request, company) together.
  @@unique([id, purchaseRequestId, companyId])
  @@index([itemId])
}

// ---------------------------------------------------------------------------
// Purchase orders (EP30) — docs/PURCHASE_ORDER.md
// ---------------------------------------------------------------------------

enum PurchaseOrderStatus {
  DRAFT
  /// The moment of issue: an issued order lands in WAITING_DEPOSIT or
  /// PENDING_RECEIVE in the same transaction (kept for a future acknowledgement step).
  ISSUED
  WAITING_DEPOSIT
  PENDING_RECEIVE
  /// EP31: every receivable line fully received (posted receipts). Cancelling a
  /// receipt can bring the order back to PENDING_RECEIVE.
  RECEIVED
  CANCELLED
}

enum PurchaseOrderDepositType {
  NONE
  /// A fixed amount in the order currency.
  AMOUNT
  /// A percentage of the grand total; the amount is computed and stored.
  PERCENT
}

enum PurchaseOrderDepositStatus {
  NOT_REQUIRED
  PENDING
  CONFIRMED
  WAIVED
}

model PurchaseOrder {
  id                         String                     @id @default(cuid())
  companyId                  String
  /// The branch of every request it orders from (database-enforced through its lines).
  branchId                   String
  branch                     Branch                     @relation(fields: [branchId, companyId], references: [id, companyId])
  /// PO-YYYYMM-NNNNNN: company-unique, immutable, from DocumentSequence.
  number                     String
  status                     PurchaseOrderStatus        @default(DRAFT)
  supplierId                 String?
  supplier                   Supplier?                  @relation(fields: [supplierId, companyId], references: [id, companyId])
  /// ISO 4217, one per order (THB by default).
  currency                   String                     @default("THB") @db.Char(3)
  orderDate                  DateTime                   @db.Date
  expectedDate               DateTime?                  @db.Date
  /// Supplier payment terms as agreed (commercial; never shown to Warehouse).
  paymentTerms               String?
  /// Remarks for the supplier (commercial views only).
  note                       String?
  lineCounter                Int                        @default(0)
  /// Server-computed totals (2 decimals, half-up per line); never from the client.
  subtotal                   Decimal                    @default(0) @db.Decimal(18, 2)
  discountTotal              Decimal                    @default(0) @db.Decimal(18, 2)
  taxTotal                   Decimal                    @default(0) @db.Decimal(18, 2)
  grandTotal                 Decimal                    @default(0) @db.Decimal(18, 2)
  depositType                PurchaseOrderDepositType   @default(NONE)
  /// The amount (AMOUNT) or percentage (PERCENT) as entered.
  depositValue               Decimal?                   @db.Decimal(18, 4)
  /// The explicit deposit amount (computed for PERCENT).
  depositAmount              Decimal?                   @db.Decimal(18, 2)
  depositDueDate             DateTime?                  @db.Date
  depositNote                String?
  depositStatus              PurchaseOrderDepositStatus @default(NOT_REQUIRED)
  depositConfirmedAt         DateTime?
  depositConfirmedByMemberId String?
  depositConfirmedBy         CompanyMember?             @relation("PurchaseOrderDepositConfirmer", fields: [depositConfirmedByMemberId, companyId], references: [id, companyId])
  /// A payment reference as given by Accounting (never bank credentials).
  depositReference           String?
  depositWaivedAt            DateTime?
  depositWaivedByMemberId    String?
  depositWaivedBy            CompanyMember?             @relation("PurchaseOrderDepositWaiver", fields: [depositWaivedByMemberId, companyId], references: [id, companyId])
  depositWaiveReason         String?
  /// Supplier identity, refreshed while DRAFT and frozen at issue.
  supplierCode               String?
  supplierName               String?
  supplierTaxId              String?
  supplierTaxBranch          String?
  supplierAddress            String?
  supplierContactName        String?
  supplierPhone              String?
  supplierEmail              String?
  /// Taken at issue.
  branchCodeSnapshot         String?
  branchNameSnapshot         String?
  createdByMemberId          String
  createdBy                  CompanyMember              @relation("PurchaseOrderCreator", fields: [createdByMemberId, companyId], references: [id, companyId])
  issuedAt                   DateTime?
  issuedByMemberId           String?
  issuedBy                   CompanyMember?             @relation("PurchaseOrderIssuer", fields: [issuedByMemberId, companyId], references: [id, companyId])
  /// When the order became ready for receiving (issue without deposit, or deposit settled).
  pendingReceiveAt           DateTime?
  /// EP31: when the last receivable quantity was received (status RECEIVED).
  receivedAt                 DateTime?
  cancelledAt                DateTime?
  cancelledByMemberId        String?
  cancelledBy                CompanyMember?             @relation("PurchaseOrderCanceller", fields: [cancelledByMemberId, companyId], references: [id, companyId])
  cancellationReason         String?
  createdAt                  DateTime                   @default(now())
  updatedAt                  DateTime                   @updatedAt
  lines                      PurchaseOrderLine[]
  /// EP31: goods receipts against this order.
  receipts                   GoodsReceipt[]

  @@unique([companyId, number])
  @@unique([id, companyId])
  /// Target of the lines' (order, branch, company) foreign key.
  @@unique([id, branchId, companyId])
  @@index([companyId, status, updatedAt])
  @@index([companyId, branchId, status])
  @@index([companyId, supplierId])
  @@index([companyId, depositStatus])
}

model PurchaseOrderLine {
  id                    String                  @id @default(cuid())
  companyId             String
  /// Copied from the order; both foreign keys below carry it, so the order and
  /// the request it orders from are in the same branch.
  branchId              String
  purchaseOrderId       String
  order                 PurchaseOrder           @relation(fields: [purchaseOrderId, branchId, companyId], references: [id, branchId, companyId], onDelete: Cascade)
  lineNo                Int
  purchaseRequestId     String
  request               PurchaseRequest         @relation(fields: [purchaseRequestId, branchId, companyId], references: [id, branchId, companyId])
  purchaseRequestLineId String
  requestLine           PurchaseRequestLine     @relation(fields: [purchaseRequestLineId, purchaseRequestId, companyId], references: [id, purchaseRequestId, companyId])
  /// Snapshots of the request line (item ones refreshed at issue, then frozen).
  prNumber              String
  prLineNo              Int
  type                  PurchaseRequestLineType
  itemId                String?
  item                  Item?                   @relation(fields: [itemId, companyId], references: [id, companyId])
  itemCode              String?
  itemName              String?
  description           String?
  unitId                String?
  unit                  Unit?                   @relation(fields: [unitId, companyId], references: [id, companyId])
  unitCode              String?
  unitName              String?
  /// Exact decimals (never floating point).
  quantity              Decimal                 @db.Decimal(18, 6)
  unitPrice             Decimal                 @default(0) @db.Decimal(18, 4)
  discountAmount        Decimal                 @default(0) @db.Decimal(18, 2)
  /// Percent, 0–100 (e.g. 7 for VAT 7 %).
  taxRate               Decimal                 @default(0) @db.Decimal(5, 2)
  /// round(quantity × unitPrice, 2)
  lineSubtotal          Decimal                 @default(0) @db.Decimal(18, 2)
  /// round((lineSubtotal − discountAmount) × taxRate / 100, 2)
  lineTax               Decimal                 @default(0) @db.Decimal(18, 2)
  /// lineSubtotal − discountAmount + lineTax
  lineTotal             Decimal                 @default(0) @db.Decimal(18, 2)
  note                  String?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  /// EP31: receipt lines that receive this line.
  receiptLines          GoodsReceiptLine[]

  @@unique([purchaseOrderId, lineNo])
  /// One line per request line per order.
  @@unique([purchaseOrderId, purchaseRequestLineId])
  @@unique([id, companyId])
  /// Target of the receipt lines' (order line, order, company) foreign key.
  @@unique([id, purchaseOrderId, companyId])
  @@index([purchaseRequestLineId])
  @@index([purchaseRequestId])
  @@index([itemId])
}

// ---------------------------------------------------------------------------
// Goods receipts and inventory (EP31) — docs/WAREHOUSE_RECEIVING.md,
// docs/INVENTORY_LEDGER.md
//
// A goods receipt receives part or all of a PENDING_RECEIVE purchase order
// into the order's branch. Accepted quantity is allocated to locations (and
// lots); posting writes one StockMovement per allocation and adds it to the
// matching StockBalance in the same transaction. Movements are immutable (a
// trigger refuses UPDATE / DELETE): a cancelled receipt writes reversal
// movements. StockBalance is a materialized sum of movements, never edited on
// its own. No cost, price or value anywhere in these tables.
// ---------------------------------------------------------------------------

enum GoodsReceiptStatus {
  DRAFT
  /// Stock was added; the receipt is locked.
  POSTED
  /// Terminal. A posted receipt that is cancelled keeps its movements and has reversal movements.
  CANCELLED
}

/// Why delivered goods were not accepted into stock.
enum ReceiptRejectReason {
  DAMAGED
  WRONG_ITEM
  EXPIRED
  QUALITY
  QUANTITY_DISCREPANCY
  OTHER
}

/// Every stock change has its own type; a reversal is its own type too (never an edit).
/// EP31: purchase receipts. EP32: transfers, adjustments, count corrections.
enum StockMovementType {
  PURCHASE_RECEIPT
  PURCHASE_RECEIPT_REVERSAL
  TRANSFER_OUT
  TRANSFER_IN
  TRANSFER_OUT_REVERSAL
  TRANSFER_IN_REVERSAL
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  ADJUSTMENT_IN_REVERSAL
  ADJUSTMENT_OUT_REVERSAL
  /// Signed: counted − system of one counted stock identity.
  COUNT_CORRECTION
  /// EP35: stock leaves at dispatch (negative), consuming the matching reservation.
  SALES_ISSUE
  /// EP37: materials leave for production when a material issue is posted (negative).
  PRODUCTION_CONSUMPTION
  /// EP38: finished goods enter stock when a finished goods receipt is posted (positive).
  PRODUCTION_OUTPUT
  /// EP38: a posted finished goods receipt reversed (negative, reservation-guarded).
  PRODUCTION_OUTPUT_REVERSAL
}

model GoodsReceipt {
  id                  String             @id @default(cuid())
  companyId           String
  /// Always the order's branch (enforced by the order foreign key).
  branchId            String
  branch              Branch             @relation(fields: [branchId, companyId], references: [id, companyId])
  /// GR-YYYYMM-NNNNNN, company-wide monthly sequence, immutable.
  number              String
  status              GoodsReceiptStatus @default(DRAFT)
  purchaseOrderId     String
  order               PurchaseOrder      @relation(fields: [purchaseOrderId, branchId, companyId], references: [id, branchId, companyId])
  /// Snapshots from the order (operational identity only).
  poNumber            String
  supplierId          String?
  supplier            Supplier?          @relation(fields: [supplierId, companyId], references: [id, companyId])
  supplierCode        String?
  supplierName        String?
  /// When the goods arrived (business time, entered by Warehouse).
  receivedAt          DateTime
  defaultLocationId   String?
  defaultLocation     WarehouseLocation? @relation("GoodsReceiptDefaultLocation", fields: [defaultLocationId, branchId], references: [id, branchId])
  note                String?
  lineCounter         Int                @default(0)
  createdByMemberId   String
  createdBy           CompanyMember      @relation("GoodsReceiptCreator", fields: [createdByMemberId, companyId], references: [id, companyId])
  postedAt            DateTime?
  postedByMemberId    String?
  postedBy            CompanyMember?     @relation("GoodsReceiptPoster", fields: [postedByMemberId, companyId], references: [id, companyId])
  cancelledAt         DateTime?
  cancelledByMemberId String?
  cancelledBy         CompanyMember?     @relation("GoodsReceiptCanceller", fields: [cancelledByMemberId, companyId], references: [id, companyId])
  cancellationReason  String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  lines               GoodsReceiptLine[]
  movements           StockMovement[]

  @@unique([companyId, number])
  @@unique([id, companyId])
  @@unique([id, branchId, companyId])
  /// Target of the lines' foreign key: a line belongs to the receipt's order and branch.
  @@unique([id, purchaseOrderId, branchId, companyId])
  @@index([purchaseOrderId])
  @@index([companyId, branchId, status, updatedAt])
}

model GoodsReceiptLine {
  id                  String                   @id @default(cuid())
  companyId           String
  branchId            String
  goodsReceiptId      String
  purchaseOrderId     String
  receipt             GoodsReceipt             @relation(fields: [goodsReceiptId, purchaseOrderId, branchId, companyId], references: [id, purchaseOrderId, branchId, companyId])
  purchaseOrderLineId String
  orderLine           PurchaseOrderLine        @relation(fields: [purchaseOrderLineId, purchaseOrderId, companyId], references: [id, purchaseOrderId, companyId])
  lineNo              Int
  /// From the order line (the server's, never the client's).
  itemId              String
  item                Item                     @relation(fields: [itemId, companyId], references: [id, companyId])
  itemCode            String
  itemName            String
  unitId              String
  unit                Unit                     @relation(fields: [unitId, companyId], references: [id, companyId])
  unitCode            String
  unitName            String?
  /// Into stock (allocated to locations / lots).
  acceptedQuantity    Decimal                  @default(0) @db.Decimal(18, 6)
  /// Delivered but not accepted: never stock.
  rejectedQuantity    Decimal                  @default(0) @db.Decimal(18, 6)
  rejectReason        ReceiptRejectReason?
  rejectNote          String?
  /// TRUE (default): the rejected quantity is still owed and stays to receive.
  /// FALSE: no replacement — the rejected quantity closes that much of the order line.
  replacementRequired Boolean                  @default(true)
  note                String?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  allocations         GoodsReceiptAllocation[]

  /// One line per order line per receipt.
  @@unique([goodsReceiptId, purchaseOrderLineId])
  @@unique([goodsReceiptId, lineNo])
  @@unique([id, itemId, branchId, companyId])
  @@index([purchaseOrderLineId])
}

/// Where accepted quantity of a receipt line goes: a location, a lot (where the item tracks lots), a quantity.
model GoodsReceiptAllocation {
  id                 String            @id @default(cuid())
  companyId          String
  branchId           String
  goodsReceiptLineId String
  itemId             String
  line               GoodsReceiptLine  @relation(fields: [goodsReceiptLineId, itemId, branchId, companyId], references: [id, itemId, branchId, companyId], onDelete: Cascade)
  locationId         String
  location           WarehouseLocation @relation(fields: [locationId, branchId], references: [id, branchId])
  /// Lot as entered (business value, kept verbatim); resolved to lotId when posted.
  lotNumber          String?
  expiryDate         DateTime?         @db.Date
  manufacturedDate   DateTime?         @db.Date
  lotId              String?
  lot                InventoryLot?     @relation(fields: [lotId, itemId, companyId], references: [id, itemId, companyId])
  quantity           Decimal           @db.Decimal(18, 6)
  createdAt          DateTime          @default(now())
  movements          StockMovement[]

  @@index([goodsReceiptLineId])
  @@index([lotId])
}

/// A lot (batch) of an item: company-wide identity (item + lot number) with one expiry date.
model InventoryLot {
  id                    String                         @id @default(cuid())
  companyId             String
  itemId                String
  item                  Item                           @relation(fields: [itemId, companyId], references: [id, companyId])
  lotNumber             String
  expiryDate            DateTime?                      @db.Date
  manufacturedDate      DateTime?                      @db.Date
  createdAt             DateTime                       @default(now())
  allocations           GoodsReceiptAllocation[]
  movements             StockMovement[]
  balances              StockBalance[]
  transferLines         InventoryTransferLine[]
  adjustmentLines       StockAdjustmentLine[]
  countLines            CycleCountLine[]
  salesAllocations      SalesAllocation[]
  salesPickLines        SalesPickLine[]
  /// EP37
  productionAllocations ProductionMaterialAllocation[] @relation("ProductionAllocationLot")
  materialIssueLines    ProductionMaterialIssueLine[]  @relation("ProductionIssueLineLot")
  /// EP38
  fgReceiptLines        ProductionGoodsReceiptLine[]   @relation("FgReceiptLineLot")

  @@unique([companyId, itemId, lotNumber])
  @@unique([id, itemId, companyId])
  @@index([companyId, expiryDate])
}

/// The inventory ledger: immutable, one row per quantity change of (location, item, lot).
model StockMovement {
  id                            String                       @id @default(cuid())
  companyId                     String
  branchId                      String
  branch                        Branch                       @relation(fields: [branchId, companyId], references: [id, companyId])
  locationId                    String
  location                      WarehouseLocation            @relation(fields: [locationId, branchId], references: [id, branchId])
  itemId                        String
  item                          Item                         @relation(fields: [itemId, companyId], references: [id, companyId])
  lotId                         String?
  lot                           InventoryLot?                @relation(fields: [lotId, itemId, companyId], references: [id, itemId, companyId])
  type                          StockMovementType
  /// Signed, exact: + into stock, − out of stock.
  quantityDelta                 Decimal                      @db.Decimal(18, 6)
  sourceType                    String
  goodsReceiptId                String?
  receipt                       GoodsReceipt?                @relation(fields: [goodsReceiptId, branchId, companyId], references: [id, branchId, companyId])
  goodsReceiptLineId            String?
  goodsReceiptAllocationId      String?
  allocation                    GoodsReceiptAllocation?      @relation(fields: [goodsReceiptAllocationId], references: [id])
  transferId                    String?
  transfer                      InventoryTransfer?           @relation(fields: [transferId, branchId, companyId], references: [id, branchId, companyId])
  transferLineId                String?
  transferLine                  InventoryTransferLine?       @relation(fields: [transferLineId], references: [id])
  adjustmentId                  String?
  adjustment                    StockAdjustment?             @relation(fields: [adjustmentId, branchId, companyId], references: [id, branchId, companyId])
  adjustmentLineId              String?
  adjustmentLine                StockAdjustmentLine?         @relation(fields: [adjustmentLineId], references: [id])
  cycleCountId                  String?
  cycleCount                    CycleCount?                  @relation(fields: [cycleCountId, branchId, companyId], references: [id, branchId, companyId])
  cycleCountLineId              String?
  cycleCountLine                CycleCountLine?              @relation(fields: [cycleCountLineId], references: [id])
  /// EP35: the dispatched shipment line (SALES_ISSUE).
  salesShipmentId               String?
  salesShipment                 SalesShipment?               @relation(fields: [salesShipmentId, branchId, companyId], references: [id, branchId, companyId])
  salesShipmentLineId           String?
  salesShipmentLine             SalesShipmentLine?           @relation(fields: [salesShipmentLineId], references: [id])
  /// EP37: the posted material issue line (PRODUCTION_CONSUMPTION).
  productionMaterialIssueId     String?
  productionMaterialIssue       ProductionMaterialIssue?     @relation(fields: [productionMaterialIssueId, branchId, companyId], references: [id, branchId, companyId])
  productionMaterialIssueLineId String?
  productionMaterialIssueLine   ProductionMaterialIssueLine? @relation(fields: [productionMaterialIssueLineId], references: [id])
  /// EP38: the posted (or reversed) finished goods receipt line (PRODUCTION_OUTPUT / _REVERSAL).
  productionGoodsReceiptId      String?
  productionGoodsReceipt        ProductionGoodsReceipt?      @relation(fields: [productionGoodsReceiptId, branchId, companyId], references: [id, branchId, companyId])
  productionGoodsReceiptLineId  String?
  productionGoodsReceiptLine    ProductionGoodsReceiptLine?  @relation(fields: [productionGoodsReceiptLineId], references: [id])
  /// Business time of the change (the receipt's receivedAt, or the cancellation time).
  occurredAt                    DateTime
  actorMemberId                 String
  actor                         CompanyMember                @relation(fields: [actorMemberId, companyId], references: [id, companyId])
  createdAt                     DateTime                     @default(now())

  /// One receipt movement and at most one reversal per allocation: a retried post cannot duplicate stock.
  @@unique([goodsReceiptAllocationId, type])
  @@unique([transferLineId, type])
  @@unique([adjustmentLineId, type])
  @@unique([cycleCountLineId, type])
  @@unique([salesShipmentLineId, type])
  @@unique([productionMaterialIssueLineId, type])
  @@unique([productionGoodsReceiptLineId, type])
  @@index([companyId, branchId, itemId, occurredAt])
  @@index([transferId])
  @@index([adjustmentId])
  @@index([salesShipmentId])
  @@index([productionMaterialIssueId])
  @@index([productionGoodsReceiptId])
  @@index([cycleCountId])
  @@index([locationId, lotId, occurredAt])
  @@index([goodsReceiptId])
}

/// On-hand quantity per (location, item, lot) — the sum of its movements, maintained with them.
model StockBalance {
  id              String            @id @default(cuid())
  companyId       String
  branchId        String
  branch          Branch            @relation(fields: [branchId, companyId], references: [id, companyId])
  locationId      String
  location        WarehouseLocation @relation(fields: [locationId, branchId], references: [id, branchId])
  itemId          String
  item            Item              @relation(fields: [itemId, companyId], references: [id, companyId])
  lotId           String?
  lot             InventoryLot?     @relation(fields: [lotId, itemId, companyId], references: [id, itemId, companyId])
  /// lotId or '' — makes (location, item, no lot) unique too.
  lotKey          String
  quantityOnHand  Decimal           @default(0) @db.Decimal(18, 6)
  /// First stock into this balance (future stock age / FIFO without lots).
  firstReceivedAt DateTime
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@unique([locationId, itemId, lotKey])
  @@index([companyId, branchId, itemId])
  @@index([lotId])
}

// ---------------------------------------------------------------------------
// Inventory control (EP32) — docs/INVENTORY_TRANSFER.md, docs/STOCK_ADJUSTMENT.md,
// docs/CYCLE_COUNT.md. Three documents that change stock only through the EP31
// ledger (warehouse/ledger.ts): every posted line writes StockMovement rows
// linked to it (unique per line and type — a retry cannot double-post) and the
// matching StockBalance in the same transaction. Quantities only — no value.
// ---------------------------------------------------------------------------

enum InventoryTransferStatus {
  DRAFT
  POSTED
  /// Terminal. A posted transfer that is cancelled keeps its movements and has reversal movements.
  CANCELLED
}

/// Moves existing stock between two locations of ONE branch (no in-transit state in EP32).
model InventoryTransfer {
  id                    String                  @id @default(cuid())
  companyId             String
  branchId              String
  branch                Branch                  @relation(fields: [branchId, companyId], references: [id, companyId])
  /// TR-YYYYMM-NNNNNN, company-wide monthly sequence, immutable.
  number                String
  status                InventoryTransferStatus @default(DRAFT)
  sourceLocationId      String
  sourceLocation        WarehouseLocation       @relation("TransferSource", fields: [sourceLocationId, branchId], references: [id, branchId])
  destinationLocationId String
  destinationLocation   WarehouseLocation       @relation("TransferDestination", fields: [destinationLocationId, branchId], references: [id, branchId])
  transferDate          DateTime                @db.Date
  note                  String?
  lineCounter           Int                     @default(0)
  createdByMemberId     String
  createdBy             CompanyMember           @relation("TransferCreator", fields: [createdByMemberId, companyId], references: [id, companyId])
  postedAt              DateTime?
  postedByMemberId      String?
  postedBy              CompanyMember?          @relation("TransferPoster", fields: [postedByMemberId, companyId], references: [id, companyId])
  cancelledAt           DateTime?
  cancelledByMemberId   String?
  cancelledBy           CompanyMember?          @relation("TransferCanceller", fields: [cancelledByMemberId, companyId], references: [id, companyId])
  cancellationReason    String?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  lines                 InventoryTransferLine[]
  movements             StockMovement[]

  @@unique([companyId, number])
  @@unique([id, branchId, companyId])
  @@index([companyId, branchId, status, updatedAt])
  @@index([sourceLocationId])
  @@index([destinationLocationId])
}

model InventoryTransferLine {
  id         String            @id @default(cuid())
  companyId  String
  branchId   String
  transferId String
  transfer   InventoryTransfer @relation(fields: [transferId, branchId, companyId], references: [id, branchId, companyId], onDelete: Cascade)
  lineNo     Int
  itemId     String
  item       Item              @relation(fields: [itemId, companyId], references: [id, companyId])
  /// The exact source lot (null: stock without a lot). A transfer never creates a lot.
  lotId      String?
  lot        InventoryLot?     @relation(fields: [lotId, itemId, companyId], references: [id, itemId, companyId])
  /// lotId or '' — one line per (item, lot) per transfer.
  lotKey     String
  quantity   Decimal           @db.Decimal(18, 6)
  note       String?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  movements  StockMovement[]

  @@unique([transferId, lineNo])
  @@unique([transferId, itemId, lotKey])
  @@index([itemId])
}

enum StockAdjustmentStatus {
  DRAFT
  /// Waiting for a manager: approving posts it (one action).
  SUBMITTED
  POSTED
  REJECTED
  /// Terminal. A posted adjustment that is cancelled keeps its movements and has reversal movements.
  CANCELLED
}

enum StockAdjustmentReason {
  DAMAGE
  LOSS
  SHRINKAGE
  FOUND
  EXPIRED
  COUNT_CORRECTION
  DATA_CORRECTION
  OTHER
}

enum AdjustmentDirection {
  INCREASE
  DECREASE
}

/// A controlled correction of stock: submitted by Warehouse, approved (and so posted) by a manager.
model StockAdjustment {
  id                  String                @id @default(cuid())
  companyId           String
  branchId            String
  branch              Branch                @relation(fields: [branchId, companyId], references: [id, companyId])
  /// ADJ-YYYYMM-NNNNNN, company-wide monthly sequence, immutable.
  number              String
  status              StockAdjustmentStatus @default(DRAFT)
  reason              StockAdjustmentReason
  note                String?
  adjustmentDate      DateTime              @db.Date
  lineCounter         Int                   @default(0)
  createdByMemberId   String
  createdBy           CompanyMember         @relation("AdjustmentCreator", fields: [createdByMemberId, companyId], references: [id, companyId])
  submittedAt         DateTime?
  submittedByMemberId String?
  submittedBy         CompanyMember?        @relation("AdjustmentSubmitter", fields: [submittedByMemberId, companyId], references: [id, companyId])
  /// Approval and posting are one action: who approved posted it.
  approvedAt          DateTime?
  approvedByMemberId  String?
  approvedBy          CompanyMember?        @relation("AdjustmentApprover", fields: [approvedByMemberId, companyId], references: [id, companyId])
  rejectedAt          DateTime?
  rejectedByMemberId  String?
  rejectedBy          CompanyMember?        @relation("AdjustmentRejecter", fields: [rejectedByMemberId, companyId], references: [id, companyId])
  rejectionReason     String?
  cancelledAt         DateTime?
  cancelledByMemberId String?
  cancelledBy         CompanyMember?        @relation("AdjustmentCanceller", fields: [cancelledByMemberId, companyId], references: [id, companyId])
  cancellationReason  String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  lines               StockAdjustmentLine[]
  movements           StockMovement[]

  @@unique([companyId, number])
  @@unique([id, branchId, companyId])
  @@index([companyId, branchId, status, updatedAt])
}

model StockAdjustmentLine {
  id           String              @id @default(cuid())
  companyId    String
  branchId     String
  adjustmentId String
  adjustment   StockAdjustment     @relation(fields: [adjustmentId, branchId, companyId], references: [id, branchId, companyId], onDelete: Cascade)
  lineNo       Int
  direction    AdjustmentDirection
  locationId   String
  location     WarehouseLocation   @relation(fields: [locationId, branchId], references: [id, branchId])
  itemId       String
  item         Item                @relation(fields: [itemId, companyId], references: [id, companyId])
  /// An existing lot (or none); an increase may instead name a new lot (resolved when posted).
  lotId        String?
  lot          InventoryLot?       @relation(fields: [lotId, itemId, companyId], references: [id, itemId, companyId])
  newLotNumber String?
  newLotExpiry DateTime?           @db.Date
  quantity     Decimal             @db.Decimal(18, 6)
  note         String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  movements    StockMovement[]

  @@unique([adjustmentId, lineNo])
  @@index([locationId])
  @@index([itemId])
}

enum CycleCountStatus {
  DRAFT
  /// Scope snapshot taken; stock movements on the counted scope are blocked.
  COUNTING
  /// Every line counted; waiting for a manager to post. Still blocks the scope.
  REVIEW
  POSTED
  CANCELLED
}

/// Physical counting of the stock of some locations of one branch (optionally one item).
model CycleCount {
  id                  String               @id @default(cuid())
  companyId           String
  branchId            String
  branch              Branch               @relation(fields: [branchId, companyId], references: [id, companyId])
  /// CC-YYYYMM-NNNNNN, company-wide monthly sequence, immutable.
  number              String
  status              CycleCountStatus     @default(DRAFT)
  /// Optional item filter: only this item is counted (and locked) in the locations.
  itemId              String?
  item                Item?                @relation(fields: [itemId, companyId], references: [id, companyId])
  note                String?
  countDate           DateTime             @db.Date
  lineCounter         Int                  @default(0)
  createdByMemberId   String
  createdBy           CompanyMember        @relation("CountCreator", fields: [createdByMemberId, companyId], references: [id, companyId])
  startedAt           DateTime?
  startedByMemberId   String?
  startedBy           CompanyMember?       @relation("CountStarter", fields: [startedByMemberId, companyId], references: [id, companyId])
  reviewAt            DateTime?
  postedAt            DateTime?
  postedByMemberId    String?
  postedBy            CompanyMember?       @relation("CountPoster", fields: [postedByMemberId, companyId], references: [id, companyId])
  cancelledAt         DateTime?
  cancelledByMemberId String?
  cancelledBy         CompanyMember?       @relation("CountCanceller", fields: [cancelledByMemberId, companyId], references: [id, companyId])
  cancellationReason  String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  locations           CycleCountLocation[]
  lines               CycleCountLine[]
  movements           StockMovement[]

  @@unique([companyId, number])
  @@unique([id, branchId, companyId])
  @@index([companyId, branchId, status, updatedAt])
}

/// The counted locations (the count's scope).
model CycleCountLocation {
  cycleCountId String
  companyId    String
  branchId     String
  count        CycleCount        @relation(fields: [cycleCountId, branchId, companyId], references: [id, branchId, companyId], onDelete: Cascade)
  locationId   String
  location     WarehouseLocation @relation(fields: [locationId, branchId], references: [id, branchId])

  @@id([cycleCountId, locationId])
  @@index([locationId])
}

model CycleCountLine {
  id                String            @id @default(cuid())
  companyId         String
  branchId          String
  cycleCountId      String
  count             CycleCount        @relation(fields: [cycleCountId, branchId, companyId], references: [id, branchId, companyId], onDelete: Cascade)
  lineNo            Int
  locationId        String
  location          WarehouseLocation @relation(fields: [locationId, branchId], references: [id, branchId])
  itemId            String
  item              Item              @relation(fields: [itemId, companyId], references: [id, companyId])
  lotId             String?
  lot               InventoryLot?     @relation(fields: [lotId, itemId, companyId], references: [id, itemId, companyId])
  /// A lot found that the system did not know (resolved when posted).
  newLotNumber      String?
  newLotExpiry      DateTime?         @db.Date
  /// lotId, 'new:' + lot number, or '' — one line per stock identity per count.
  lotKey            String
  /// TRUE: from the start snapshot; FALSE: stock found that the system did not show.
  expected          Boolean
  /// On hand when the count started (0 for an unexpected line).
  systemQuantity    Decimal           @default(0) @db.Decimal(18, 6)
  /// What was physically counted (null: not counted yet; 0 is a real count).
  countedQuantity   Decimal?          @db.Decimal(18, 6)
  countedAt         DateTime?
  countedByMemberId String?
  countedBy         CompanyMember?    @relation("CountLineCounter", fields: [countedByMemberId, companyId], references: [id, companyId])
  note              String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  movements         StockMovement[]

  @@unique([cycleCountId, lineNo])
  @@unique([cycleCountId, locationId, itemId, lotKey])
  @@index([itemId])
}

// ---------------------------------------------------------------- EP33 sales orders

/// DRAFT → SUBMITTED → CONFIRMED; CANCELLED before or after confirmation (docs/SALES_ORDER.md).
/// No fulfilment status yet: EP34 allocates confirmed lines, EP35 delivers and completes.
enum SalesOrderStatus {
  DRAFT
  SUBMITTED
  CONFIRMED
  CANCELLED
}

/// Commercial demand: what a customer ordered, at what price. It never moves or
/// reserves stock — availability is read from the ledger and never stored.
model SalesOrder {
  id                  String            @id @default(cuid())
  companyId           String
  branchId            String
  branch              Branch            @relation(fields: [branchId, companyId], references: [id, companyId])
  /// SO-YYYYMM-NNNNNN, company-wide monthly sequence (DocumentSequence), immutable.
  number              String
  status              SalesOrderStatus  @default(DRAFT)
  customerId          String
  customer            Customer          @relation(fields: [customerId, companyId], references: [id, companyId])
  /// Customer identity as ordered — taken from the master on every draft change,
  /// refreshed at submit and confirm, then frozen.
  customerCode        String
  customerName        String
  customerTaxId       String?
  customerTaxBranch   String?
  /// Business dates (calendar days), separate from createdAt.
  orderDate           DateTime          @db.Date
  requestedDate       DateTime?         @db.Date
  /// The customer's own PO / reference number (plain text).
  customerReference   String?
  note                String?
  currency            String            @default("THB") @db.Char(3)
  lineCounter         Int               @default(0)
  /// Server arithmetic only (purchasing/money.ts); the client's totals are never read.
  subtotal            Decimal           @default(0) @db.Decimal(18, 2)
  discountTotal       Decimal           @default(0) @db.Decimal(18, 2)
  taxTotal            Decimal           @default(0) @db.Decimal(18, 2)
  grandTotal          Decimal           @default(0) @db.Decimal(18, 2)
  createdByMemberId   String
  createdBy           CompanyMember     @relation("SalesOrderCreator", fields: [createdByMemberId, companyId], references: [id, companyId])
  submittedAt         DateTime?
  submittedByMemberId String?
  submittedBy         CompanyMember?    @relation("SalesOrderSubmitter", fields: [submittedByMemberId, companyId], references: [id, companyId])
  confirmedAt         DateTime?
  confirmedByMemberId String?
  confirmedBy         CompanyMember?    @relation("SalesOrderConfirmer", fields: [confirmedByMemberId, companyId], references: [id, companyId])
  cancelledAt         DateTime?
  cancelledByMemberId String?
  cancelledBy         CompanyMember?    @relation("SalesOrderCanceller", fields: [cancelledByMemberId, companyId], references: [id, companyId])
  cancellationReason  String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  lines               SalesOrderLine[]
  /// EP34: reservations of this order's lines (history kept: RELEASED rows stay).
  allocations         SalesAllocation[]
  /// EP35 fulfilment documents.
  picks               SalesPick[]
  packs               SalesPack[]
  shipments           SalesShipment[]
  /// EP36: production orders planned for this order (planning only).
  productionOrders    ProductionOrder[]

  @@unique([companyId, number])
  @@unique([id, companyId])
  @@unique([id, branchId, companyId])
  @@index([companyId, branchId, status, updatedAt])
  @@index([companyId, customerId])
  @@index([companyId, orderDate])
  @@index([companyId, requestedDate])
  @@index([createdByMemberId])
}

/// One ordered item. Item, unit and type are snapshots (frozen at confirmation);
/// quantity respects the unit's decimal places. EP34 allocates against these lines.
model SalesOrderLine {
  id               String     @id @default(cuid())
  companyId        String
  branchId         String
  salesOrderId     String
  order            SalesOrder @relation(fields: [salesOrderId, branchId, companyId], references: [id, branchId, companyId], onDelete: Cascade)
  lineNo           Int
  itemId           String
  item             Item       @relation(fields: [itemId, companyId], references: [id, companyId])
  itemCode         String
  itemName         String
  itemType         ItemType
  /// Snapshot of the item's inventoryTracked: false = a commercial line only (no availability).
  inventoryTracked Boolean
  unitId           String
  unit             Unit       @relation(fields: [unitId, companyId], references: [id, companyId])
  unitCode         String
  unitName         String
  unitPrecision    Int
  quantity         Decimal    @db.Decimal(18, 6)
  unitPrice        Decimal    @default(0) @db.Decimal(18, 4)
  discountAmount   Decimal    @default(0) @db.Decimal(18, 2)
  /// Percent, 0–100, exclusive (the EP30 tax model).
  taxRate          Decimal    @default(0) @db.Decimal(5, 2)
  lineSubtotal     Decimal    @default(0) @db.Decimal(18, 2)
  lineTax          Decimal    @default(0) @db.Decimal(18, 2)
  lineTotal        Decimal    @default(0) @db.Decimal(18, 2)
  note             String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  /// EP34
  allocations      SalesAllocation[]
  pickLines        SalesPickLine[]
  packLines        SalesPackLine[]
  shipmentLines    SalesShipmentLine[]
  productionOrders ProductionOrder[]

  @@unique([salesOrderId, lineNo])
  /// Target of EP34 allocation foreign keys (line, order, company).
  @@unique([id, salesOrderId, companyId])
  @@index([companyId, itemId])
}

// ---------------------------------------------------------------- EP34 sales allocation

/// ACTIVE → RELEASED (released, reallocated or order cancelled); CONSUMED is reserved
/// for EP35, when the SALES_ISSUE movement takes the stock out (docs/SALES_ALLOCATION.md).
enum SalesAllocationStatus {
  ACTIVE
  RELEASED
  CONSUMED
}

enum SalesAllocationRelease {
  RELEASED
  REALLOCATED
  ORDER_CANCELLED
}

/// A reservation: a quantity of ONE stock identity (branch, location, item, lot) claimed
/// for one line of a CONFIRMED sales order. It is not a movement — on hand never changes;
/// available = on hand − Σ ACTIVE reservations of that identity, kept ≥ 0 by
/// sales/allocation.ts (allocating) and the ledger's decrease guard (every other writer).
model SalesAllocation {
  id                  String                  @id @default(cuid())
  companyId           String
  branchId            String
  branch              Branch                  @relation(fields: [branchId, companyId], references: [id, companyId])
  salesOrderId        String
  order               SalesOrder              @relation(fields: [salesOrderId, branchId, companyId], references: [id, branchId, companyId])
  salesOrderLineId    String
  line                SalesOrderLine          @relation(fields: [salesOrderLineId, salesOrderId, companyId], references: [id, salesOrderId, companyId])
  itemId              String
  item                Item                    @relation(fields: [itemId, companyId], references: [id, companyId])
  locationId          String
  location            WarehouseLocation       @relation(fields: [locationId, branchId], references: [id, branchId])
  lotId               String?
  lot                 InventoryLot?           @relation(fields: [lotId, itemId, companyId], references: [id, itemId, companyId])
  /// lotId or '' — the StockBalance identity key.
  lotKey              String
  quantity            Decimal                 @db.Decimal(18, 6)
  status              SalesAllocationStatus   @default(ACTIVE)
  /// true while ACTIVE, NULL after: one ACTIVE row per (line, location, lot).
  activeSlot          Boolean?                @default(true)
  createdByMemberId   String
  createdBy           CompanyMember           @relation("SalesAllocationCreator", fields: [createdByMemberId, companyId], references: [id, companyId])
  releasedAt          DateTime?
  releasedByMemberId  String?
  releasedBy          CompanyMember?          @relation("SalesAllocationReleaser", fields: [releasedByMemberId, companyId], references: [id, companyId])
  releaseReason       SalesAllocationRelease?
  /// EP35: CONSUMED rows — the dispatched shipment line that took this quantity out.
  consumedAt          DateTime?
  salesShipmentLineId String?                 @unique
  consumedBy          SalesShipmentLine?      @relation(fields: [salesShipmentLineId], references: [id])
  /// EP35: a partial dispatch splits the ACTIVE row; the CONSUMED part names its origin.
  splitFromId         String?
  splitFrom           SalesAllocation?        @relation("SalesAllocationSplit", fields: [splitFromId], references: [id])
  splits              SalesAllocation[]       @relation("SalesAllocationSplit")
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  pickLines           SalesPickLine[]

  @@unique([salesOrderLineId, locationId, lotKey, activeSlot])
  /// EP35: target of pick-line foreign keys (the reservation, its line and identity).
  @@unique([id, salesOrderLineId, locationId, lotKey])
  @@index([locationId, itemId, lotKey, status])
  @@index([companyId, branchId, itemId, status])
  @@index([salesOrderId, status])
}

// ---------------------------------------------------------------- EP35 sales fulfilment

/// DRAFT → IN_PROGRESS → PICKED; DRAFT / IN_PROGRESS (or PICKED with nothing packed) → CANCELLED.
enum SalesPickStatus {
  DRAFT
  IN_PROGRESS
  PICKED
  CANCELLED
}

enum SalesPickDiscrepancy {
  SHORT_PICKED
  DAMAGED
  MISSING
  WRONG_ITEM
  OTHER
}

/// DRAFT → PACKED → DISPATCHED (with its shipment); DRAFT / PACKED → CANCELLED.
enum SalesPackStatus {
  DRAFT
  PACKED
  DISPATCHED
  CANCELLED
}

/// READY → DISPATCHED (stock issued) → DELIVERED, or → DELIVERY_EXCEPTION → DELIVERED; READY → CANCELLED.
enum SalesShipmentStatus {
  READY
  DISPATCHED
  DELIVERED
  DELIVERY_EXCEPTION
  CANCELLED
}

enum SalesDeliveryEventType {
  DELIVERED
  PARTIALLY_DELIVERED
  EXCEPTION
}

enum SalesDeliveryException {
  FAILED_ATTEMPT
  RECIPIENT_UNAVAILABLE
  ADDRESS_ISSUE
  DAMAGED_IN_TRANSIT
  LOST_IN_TRANSIT
  PARTIAL_DELIVERY
  OTHER
}

/// A pick task: take reserved stock (the exact location + lot of an ACTIVE reservation)
/// off the shelf for one CONFIRMED sales order. Never a movement (docs/SALES_FULFILLMENT.md).
model SalesPick {
  id                  String          @id @default(cuid())
  companyId           String
  branchId            String
  branch              Branch          @relation(fields: [branchId, companyId], references: [id, companyId])
  salesOrderId        String
  order               SalesOrder      @relation(fields: [salesOrderId, branchId, companyId], references: [id, branchId, companyId])
  /// PICK-YYYYMM-NNNNNN, company-wide monthly sequence, immutable.
  number              String
  status              SalesPickStatus @default(DRAFT)
  note                String?
  createdByMemberId   String
  createdBy           CompanyMember   @relation("SalesPickCreator", fields: [createdByMemberId, companyId], references: [id, companyId])
  startedAt           DateTime?
  startedByMemberId   String?
  startedBy           CompanyMember?  @relation("SalesPickStarter", fields: [startedByMemberId, companyId], references: [id, companyId])
  pickedAt            DateTime?
  pickedByMemberId    String?
  pickedBy            CompanyMember?  @relation("SalesPickConfirmer", fields: [pickedByMemberId, companyId], references: [id, companyId])
  cancelledAt         DateTime?
  cancelledByMemberId String?
  cancelledBy         CompanyMember?  @relation("SalesPickCanceller", fields: [cancelledByMemberId, companyId], references: [id, companyId])
  cancellationReason  String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  lines               SalesPickLine[]

  @@unique([companyId, number])
  @@unique([id, salesOrderId, branchId, companyId])
  @@index([companyId, branchId, status, updatedAt])
  @@index([salesOrderId])
}

/// One reservation to pick. Exact counters: planned ≥ picked ≥ packed ≥ dispatched —
/// CHECKed, so no pick, pack or dispatch can exceed the step before it.
model SalesPickLine {
  id                 String                @id @default(cuid())
  companyId          String
  branchId           String
  salesOrderId       String
  pickId             String
  pick               SalesPick             @relation(fields: [pickId, salesOrderId, branchId, companyId], references: [id, salesOrderId, branchId, companyId])
  lineNo             Int
  salesOrderLineId   String
  orderLine          SalesOrderLine        @relation(fields: [salesOrderLineId, salesOrderId, companyId], references: [id, salesOrderId, companyId])
  allocationId       String
  allocation         SalesAllocation       @relation(fields: [allocationId, salesOrderLineId, locationId, lotKey], references: [id, salesOrderLineId, locationId, lotKey])
  itemId             String
  item               Item                  @relation(fields: [itemId, companyId], references: [id, companyId])
  locationId         String
  location           WarehouseLocation     @relation(fields: [locationId, branchId], references: [id, branchId])
  lotId              String?
  lot                InventoryLot?         @relation(fields: [lotId, itemId, companyId], references: [id, itemId, companyId])
  lotKey             String
  plannedQuantity    Decimal               @db.Decimal(18, 6)
  /// Null until the pick is confirmed; less than planned needs a discrepancy.
  pickedQuantity     Decimal?              @db.Decimal(18, 6)
  discrepancy        SalesPickDiscrepancy?
  discrepancyNote    String?
  packedQuantity     Decimal               @default(0) @db.Decimal(18, 6)
  dispatchedQuantity Decimal               @default(0) @db.Decimal(18, 6)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  packLines          SalesPackLine[]

  @@unique([pickId, lineNo])
  /// Target of pack-line foreign keys.
  @@unique([id, salesOrderLineId])
  @@index([allocationId])
  @@index([salesOrderId])
}

/// A pack: picked stock boxed for handover. One order; several packs per order.
model SalesPack {
  id                  String          @id @default(cuid())
  companyId           String
  branchId            String
  branch              Branch          @relation(fields: [branchId, companyId], references: [id, companyId])
  salesOrderId        String
  order               SalesOrder      @relation(fields: [salesOrderId, branchId, companyId], references: [id, branchId, companyId])
  /// PACK-YYYYMM-NNNNNN, immutable.
  number              String
  status              SalesPackStatus @default(DRAFT)
  packageCount        Int             @default(1)
  packageReference    String?
  note                String?
  /// The non-cancelled shipment this pack travels in (null = not shipped yet).
  shipmentId          String?
  shipment            SalesShipment?  @relation(fields: [shipmentId], references: [id])
  createdByMemberId   String
  createdBy           CompanyMember   @relation("SalesPackCreator", fields: [createdByMemberId, companyId], references: [id, companyId])
  packedAt            DateTime?
  packedByMemberId    String?
  packedBy            CompanyMember?  @relation("SalesPackPacker", fields: [packedByMemberId, companyId], references: [id, companyId])
  dispatchedAt        DateTime?
  cancelledAt         DateTime?
  cancelledByMemberId String?
  cancelledBy         CompanyMember?  @relation("SalesPackCanceller", fields: [cancelledByMemberId, companyId], references: [id, companyId])
  cancellationReason  String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  lines               SalesPackLine[]

  @@unique([companyId, number])
  @@unique([id, salesOrderId, companyId])
  @@index([companyId, branchId, status, updatedAt])
  @@index([salesOrderId])
  @@index([shipmentId])
}

model SalesPackLine {
  id               String              @id @default(cuid())
  companyId        String
  salesOrderId     String
  packId           String
  pack             SalesPack           @relation(fields: [packId, salesOrderId, companyId], references: [id, salesOrderId, companyId])
  lineNo           Int
  pickLineId       String
  pickLine         SalesPickLine       @relation(fields: [pickLineId, salesOrderLineId], references: [id, salesOrderLineId])
  salesOrderLineId String
  orderLine        SalesOrderLine      @relation(fields: [salesOrderLineId, salesOrderId, companyId], references: [id, salesOrderId, companyId])
  quantity         Decimal             @db.Decimal(18, 6)
  createdAt        DateTime            @default(now())
  shipmentLines    SalesShipmentLine[]

  @@unique([packId, lineNo])
  /// Target of shipment-line foreign keys.
  @@unique([id, pickLineId, salesOrderLineId])
  @@index([pickLineId])
}

/// A shipment: packs handed over together. DISPATCH is the stock issue point.
model SalesShipment {
  id                   String               @id @default(cuid())
  companyId            String
  branchId             String
  branch               Branch               @relation(fields: [branchId, companyId], references: [id, companyId])
  salesOrderId         String
  order                SalesOrder           @relation(fields: [salesOrderId, branchId, companyId], references: [id, branchId, companyId])
  /// SHP-YYYYMM-NNNNNN, immutable.
  number               String
  status               SalesShipmentStatus  @default(READY)
  /// Where it goes (operational; typed, or the order's customer name).
  shipToName           String
  shipToAddress        String?
  carrier              String?
  trackingReference    String?
  note                 String?
  createdByMemberId    String
  createdBy            CompanyMember        @relation("SalesShipmentCreator", fields: [createdByMemberId, companyId], references: [id, companyId])
  dispatchedAt         DateTime?
  dispatchedByMemberId String?
  dispatchedBy         CompanyMember?       @relation("SalesShipmentDispatcher", fields: [dispatchedByMemberId, companyId], references: [id, companyId])
  handedOverTo         String?
  deliveredAt          DateTime?
  cancelledAt          DateTime?
  cancelledByMemberId  String?
  cancelledBy          CompanyMember?       @relation("SalesShipmentCanceller", fields: [cancelledByMemberId, companyId], references: [id, companyId])
  cancellationReason   String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  lines                SalesShipmentLine[]
  packs                SalesPack[]
  events               SalesDeliveryEvent[]
  movements            StockMovement[]

  @@unique([companyId, number])
  @@unique([id, branchId, companyId])
  @@unique([id, salesOrderId, companyId])
  @@index([companyId, branchId, status, updatedAt])
  @@index([salesOrderId])
}

/// One pack line in a shipment: what is dispatched (and later delivered).
model SalesShipmentLine {
  id                String           @id @default(cuid())
  companyId         String
  salesOrderId      String
  shipmentId        String
  shipment          SalesShipment    @relation(fields: [shipmentId, salesOrderId, companyId], references: [id, salesOrderId, companyId])
  lineNo            Int
  packLineId        String
  packLine          SalesPackLine    @relation(fields: [packLineId, pickLineId, salesOrderLineId], references: [id, pickLineId, salesOrderLineId])
  pickLineId        String
  salesOrderLineId  String
  orderLine         SalesOrderLine   @relation(fields: [salesOrderLineId, salesOrderId, companyId], references: [id, salesOrderId, companyId])
  quantity          Decimal          @db.Decimal(18, 6)
  /// Confirmed received (≤ quantity); the rest stays outstanding / an exception.
  deliveredQuantity Decimal          @default(0) @db.Decimal(18, 6)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  movements         StockMovement[]
  consumption       SalesAllocation?

  @@unique([shipmentId, lineNo])
  @@index([packLineId])
  @@index([salesOrderLineId])
}

/// Immutable delivery evidence (a database trigger refuses UPDATE / DELETE).
model SalesDeliveryEvent {
  id                 String                  @id @default(cuid())
  companyId          String
  shipmentId         String
  shipment           SalesShipment           @relation(fields: [shipmentId], references: [id])
  type               SalesDeliveryEventType
  reason             SalesDeliveryException?
  recipientName      String?
  reference          String?
  note               String?
  /// Business time of the outcome (may be earlier than when it was recorded).
  occurredAt         DateTime
  recordedByMemberId String
  recordedBy         CompanyMember           @relation(fields: [recordedByMemberId, companyId], references: [id, companyId])
  createdAt          DateTime                @default(now())

  @@index([shipmentId, occurredAt])
}

// ---------------------------------------------------------------------------
// Production planning (EP36) — docs/PRODUCTION_BOM.md, docs/PRODUCTION_ORDER.md
//
// Planning only, inside the Operations department. A BOM says how much of each
// material makes a base quantity of one finished item; a production order
// plans an output quantity in one branch from one ACTIVE BOM revision and
// freezes its material requirements at approval. Nothing here writes stock,
// reserves stock or creates output: availability is read from the ledger on
// every response and never stored. EP37 (material issue) and EP38 (finished
// goods receipt) will move stock through ledger.ts.
// ---------------------------------------------------------------------------

/// DRAFT (editable) → ACTIVE (immutable; at most one per finished item) → RETIRED.
enum ProductionBomStatus {
  DRAFT
  ACTIVE
  RETIRED
}

/// A single-level bill of materials revision for one finished item.
model ProductionBom {
  id                  String              @id @default(cuid())
  companyId           String
  company             Company             @relation(fields: [companyId], references: [id])
  /// The finished item (FINISHED_GOOD, inventory tracked).
  itemId              String
  item                Item                @relation("ProductionBomOutput", fields: [itemId, companyId], references: [id, companyId])
  itemCode            String
  itemName            String
  /// BOM-<item code>, the same for every revision of the item.
  code                String
  /// 1, 2, 3 … per finished item, never reused.
  revision            Int
  /// The quantity of finished item the lines make, in the item's base unit.
  outputQuantity      Decimal             @db.Decimal(18, 6)
  unitId              String
  unit                Unit                @relation("ProductionBomUnit", fields: [unitId, companyId], references: [id, companyId])
  unitCode            String
  unitPrecision       Int
  status              ProductionBomStatus @default(DRAFT)
  /// TRUE while ACTIVE, NULL otherwise: one ACTIVE revision per finished item.
  activeSlot          Boolean?
  note                String?
  lineCounter         Int                 @default(0)
  createdByMemberId   String
  createdBy           CompanyMember       @relation("ProductionBomCreator", fields: [createdByMemberId, companyId], references: [id, companyId])
  activatedAt         DateTime?
  activatedByMemberId String?
  activatedBy         CompanyMember?      @relation("ProductionBomActivator", fields: [activatedByMemberId, companyId], references: [id, companyId])
  retiredAt           DateTime?
  retiredByMemberId   String?
  retiredBy           CompanyMember?      @relation("ProductionBomRetirer", fields: [retiredByMemberId, companyId], references: [id, companyId])
  retirementReason    String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  lines               ProductionBomLine[]
  orders              ProductionOrder[]

  @@unique([companyId, itemId, revision])
  @@unique([companyId, itemId, activeSlot])
  @@unique([id, companyId])
  /// Target of line and production-order foreign keys (the BOM and its finished item).
  @@unique([id, itemId, companyId])
  @@index([companyId, status, updatedAt])
}

/// One material of a BOM revision, in the material's base unit (no conversion).
model ProductionBomLine {
  id            String        @id @default(cuid())
  companyId     String
  bomId         String
  /// The BOM's finished item — carried so the database refuses a BOM consuming itself.
  bomItemId     String
  bom           ProductionBom @relation(fields: [bomId, bomItemId, companyId], references: [id, itemId, companyId], onDelete: Cascade)
  lineNo        Int
  itemId        String
  item          Item          @relation("ProductionBomMaterial", fields: [itemId, companyId], references: [id, companyId])
  itemCode      String
  itemName      String
  itemType      ItemType
  unitId        String
  unit          Unit          @relation("ProductionBomLineUnit", fields: [unitId, companyId], references: [id, companyId])
  unitCode      String
  unitPrecision Int
  /// Needed per `outputQuantity` of the finished item.
  quantity      Decimal       @db.Decimal(18, 6)
  note          String?
  createdAt     DateTime      @default(now())

  @@unique([bomId, lineNo])
  @@unique([bomId, itemId])
  @@index([companyId, itemId])
}

/// DRAFT → SUBMITTED → APPROVED → READY; SUBMITTED → REJECTED; DRAFT / APPROVED / READY → CANCELLED.
/// EP37: READY → IN_PRODUCTION ⇄ PAUSED (execution).
/// EP38: IN_PRODUCTION / PAUSED → COMPLETION_REVIEW → COMPLETED (or back to IN_PRODUCTION).
enum ProductionOrderStatus {
  DRAFT
  SUBMITTED
  APPROVED
  READY
  IN_PRODUCTION
  PAUSED
  COMPLETION_REVIEW
  COMPLETED
  REJECTED
  CANCELLED
}

enum ProductionOrderSource {
  MANUAL
  SALES_DEMAND
}

enum ProductionPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

/// A planned output of one finished item in one branch (MO-YYYYMM-NNNNNN). Planning only.
model ProductionOrder {
  id                        String                         @id @default(cuid())
  companyId                 String
  branchId                  String
  branch                    Branch                         @relation(fields: [branchId, companyId], references: [id, companyId])
  number                    String
  status                    ProductionOrderStatus          @default(DRAFT)
  source                    ProductionOrderSource
  /// SALES_DEMAND: the confirmed sales order (same branch) and line (same item) it answers.
  salesOrderId              String?
  salesOrder                SalesOrder?                    @relation(fields: [salesOrderId, branchId, companyId], references: [id, branchId, companyId])
  salesOrderLineId          String?
  salesOrderLine            SalesOrderLine?                @relation(fields: [salesOrderLineId, salesOrderId, companyId], references: [id, salesOrderId, companyId])
  itemId                    String
  item                      Item                           @relation("ProductionOrderOutput", fields: [itemId, companyId], references: [id, companyId])
  itemCode                  String
  itemName                  String
  unitId                    String
  unit                      Unit                           @relation("ProductionOrderUnit", fields: [unitId, companyId], references: [id, companyId])
  unitCode                  String
  unitPrecision             Int
  /// The BOM revision used (always one of the order's item); frozen at approval.
  bomId                     String?
  bom                       ProductionBom?                 @relation(fields: [bomId, itemId, companyId], references: [id, itemId, companyId])
  bomCode                   String?
  bomRevision               Int?
  bomOutputQuantity         Decimal?                       @db.Decimal(18, 6)
  /// Target output in the item's base unit.
  quantity                  Decimal                        @db.Decimal(18, 6)
  plannedStartDate          DateTime?                      @db.Date
  requiredDate              DateTime?                      @db.Date
  priority                  ProductionPriority             @default(NORMAL)
  note                      String?
  createdByMemberId         String
  createdBy                 CompanyMember                  @relation("ProductionOrderCreator", fields: [createdByMemberId, companyId], references: [id, companyId])
  submittedAt               DateTime?
  submittedByMemberId       String?
  submittedBy               CompanyMember?                 @relation("ProductionOrderSubmitter", fields: [submittedByMemberId, companyId], references: [id, companyId])
  approvedAt                DateTime?
  approvedByMemberId        String?
  approvedBy                CompanyMember?                 @relation("ProductionOrderApprover", fields: [approvedByMemberId, companyId], references: [id, companyId])
  releasedAt                DateTime?
  releasedByMemberId        String?
  releasedBy                CompanyMember?                 @relation("ProductionOrderReleaser", fields: [releasedByMemberId, companyId], references: [id, companyId])
  rejectedAt                DateTime?
  rejectedByMemberId        String?
  rejectedBy                CompanyMember?                 @relation("ProductionOrderRejecter", fields: [rejectedByMemberId, companyId], references: [id, companyId])
  rejectionReason           String?
  cancelledAt               DateTime?
  cancelledByMemberId       String?
  cancelledBy               CompanyMember?                 @relation("ProductionOrderCanceller", fields: [cancelledByMemberId, companyId], references: [id, companyId])
  cancellationReason        String?
  /// EP37 execution: started (READY → IN_PRODUCTION), paused now (PAUSED), the latest work note.
  startedAt                 DateTime?
  startedByMemberId         String?
  startedBy                 CompanyMember?                 @relation("ProductionOrderStarter", fields: [startedByMemberId, companyId], references: [id, companyId])
  pausedAt                  DateTime?
  executionNote             String?
  /// EP38 completion: review requested, then closed (COMPLETED or SHORT_CLOSED; a short close has a reason).
  reviewRequestedAt         DateTime?
  reviewRequestedByMemberId String?
  reviewRequestedBy         CompanyMember?                 @relation("ProductionOrderReviewRequester", fields: [reviewRequestedByMemberId, companyId], references: [id, companyId])
  completedAt               DateTime?
  completedByMemberId       String?
  completedBy               CompanyMember?                 @relation("ProductionOrderCompleter", fields: [completedByMemberId, companyId], references: [id, companyId])
  completionOutcome         ProductionCompletionOutcome?
  completionReason          String?
  createdAt                 DateTime                       @default(now())
  updatedAt                 DateTime                       @updatedAt
  materials                 ProductionOrderMaterial[]
  allocations               ProductionMaterialAllocation[]
  issues                    ProductionMaterialIssue[]
  outputReports             ProductionOutputReport[]
  fgReceipts                ProductionGoodsReceipt[]

  @@unique([companyId, number])
  @@unique([id, companyId])
  /// EP37: target of reservation and issue foreign keys (same branch and company).
  @@unique([id, branchId, companyId])
  @@index([companyId, branchId, status, updatedAt])
  @@index([companyId, itemId])
  @@index([salesOrderLineId])
  @@index([bomId])
}

/// A material requirement of an order: server-computed from its BOM revision
/// (target × line quantity ÷ BOM output, rounded UP to the unit's places), frozen at approval.
model ProductionOrderMaterial {
  id                String                         @id @default(cuid())
  companyId         String
  productionOrderId String
  order             ProductionOrder                @relation(fields: [productionOrderId, companyId], references: [id, companyId], onDelete: Cascade)
  lineNo            Int
  itemId            String
  item              Item                           @relation("ProductionOrderMaterial", fields: [itemId, companyId], references: [id, companyId])
  itemCode          String
  itemName          String
  unitId            String
  unit              Unit                           @relation("ProductionOrderMaterialUnit", fields: [unitId, companyId], references: [id, companyId])
  unitCode          String
  unitPrecision     Int
  /// The BOM line's quantity per BOM output quantity.
  bomQuantity       Decimal                        @db.Decimal(18, 6)
  requiredQuantity  Decimal                        @db.Decimal(18, 6)
  createdAt         DateTime                       @default(now())
  allocations       ProductionMaterialAllocation[]
  usage             ProductionMaterialUsage[]

  @@unique([productionOrderId, lineNo])
  @@unique([productionOrderId, itemId])
  /// EP37: targets of reservation (same item) and usage foreign keys.
  @@unique([id, productionOrderId, itemId])
  @@unique([id, productionOrderId])
  @@index([companyId, itemId])
}

// ---------------------------------------------------------------------------
// Material reservation, material issue and production execution (EP37) —
// docs/PRODUCTION_MATERIAL_RESERVATION.md, docs/PRODUCTION_MATERIAL_ISSUE.md,
// docs/PRODUCTION_EXECUTION.md
//
// A production reservation claims stock for one frozen material requirement of
// an approved production order — the production counterpart of the EP34 sales
// reservation, counted by the SAME guard (warehouse/reservations.ts): every
// reserve and every physical decrease respects sales + production reservations.
// Posting a material issue is the only production stock writer
// (PRODUCTION_CONSUMPTION through ledger.ts). Usage records are evidence only.
// ---------------------------------------------------------------------------

/// ACTIVE → RELEASED (released, reallocated, order cancelled) or CONSUMED (issued).
enum ProductionAllocationStatus {
  ACTIVE
  RELEASED
  CONSUMED
}

enum ProductionAllocationRelease {
  RELEASED
  REALLOCATED
  ORDER_CANCELLED
  /// EP38: released when the order was short-closed.
  ORDER_CLOSED
}

/// A reservation of ONE stock identity (branch, location, item, lot) for one material of a production order.
model ProductionMaterialAllocation {
  id                 String                         @id @default(cuid())
  companyId          String
  branchId           String
  branch             Branch                         @relation(fields: [branchId, companyId], references: [id, companyId])
  productionOrderId  String
  order              ProductionOrder                @relation(fields: [productionOrderId, branchId, companyId], references: [id, branchId, companyId])
  /// The frozen requirement it serves (and through it the same item).
  materialId         String
  material           ProductionOrderMaterial        @relation(fields: [materialId, productionOrderId, itemId], references: [id, productionOrderId, itemId])
  itemId             String
  item               Item                           @relation("ProductionAllocationItem", fields: [itemId, companyId], references: [id, companyId])
  locationId         String
  location           WarehouseLocation              @relation("ProductionAllocationLocation", fields: [locationId, branchId], references: [id, branchId])
  lotId              String?
  lot                InventoryLot?                  @relation("ProductionAllocationLot", fields: [lotId, itemId, companyId], references: [id, itemId, companyId])
  /// lotId or '' — the StockBalance identity key.
  lotKey             String
  quantity           Decimal                        @db.Decimal(18, 6)
  /// Manager-authorized quantity beyond the frozen requirement (reason required).
  excess             Boolean                        @default(false)
  excessReason       String?
  status             ProductionAllocationStatus     @default(ACTIVE)
  /// true while ACTIVE, NULL after: one ACTIVE row per (material, location, lot, excess).
  activeSlot         Boolean?                       @default(true)
  createdByMemberId  String
  createdBy          CompanyMember                  @relation("ProductionAllocationCreator", fields: [createdByMemberId, companyId], references: [id, companyId])
  releasedAt         DateTime?
  releasedByMemberId String?
  releasedBy         CompanyMember?                 @relation("ProductionAllocationReleaser", fields: [releasedByMemberId, companyId], references: [id, companyId])
  releaseReason      ProductionAllocationRelease?
  /// CONSUMED rows: the posted issue line that took this quantity out.
  consumedAt         DateTime?
  issueLineId        String?                        @unique
  consumedBy         ProductionMaterialIssueLine?   @relation("ProductionAllocationConsumption", fields: [issueLineId], references: [id])
  /// A partial issue splits the ACTIVE row; the CONSUMED part names its origin.
  splitFromId        String?
  splitFrom          ProductionMaterialAllocation?  @relation("ProductionAllocationSplit", fields: [splitFromId], references: [id])
  splits             ProductionMaterialAllocation[] @relation("ProductionAllocationSplit")
  createdAt          DateTime                       @default(now())
  updatedAt          DateTime                       @updatedAt
  issueLines         ProductionMaterialIssueLine[]  @relation("ProductionIssueLineAllocation")

  @@unique([materialId, locationId, lotKey, excess, activeSlot])
  /// Target of issue-line foreign keys (the reservation, its order, material and identity).
  @@unique([id, productionOrderId, materialId, locationId, lotKey])
  @@index([locationId, itemId, lotKey, status])
  @@index([companyId, branchId, itemId, status])
  @@index([productionOrderId, status])
}

/// DRAFT → POSTED (stock leaves) or DRAFT → CANCELLED. POSTED is immutable.
enum MaterialIssueStatus {
  DRAFT
  POSTED
  CANCELLED
}

/// A material issue (MI-YYYYMM-NNNNNN): reserved materials leaving the warehouse for one production order.
model ProductionMaterialIssue {
  id                  String                        @id @default(cuid())
  companyId           String
  branchId            String
  branch              Branch                        @relation(fields: [branchId, companyId], references: [id, companyId])
  productionOrderId   String
  order               ProductionOrder               @relation(fields: [productionOrderId, branchId, companyId], references: [id, branchId, companyId])
  number              String
  status              MaterialIssueStatus           @default(DRAFT)
  note                String?
  lineCounter         Int                           @default(0)
  createdByMemberId   String
  createdBy           CompanyMember                 @relation("MaterialIssueCreator", fields: [createdByMemberId, companyId], references: [id, companyId])
  postedAt            DateTime?
  postedByMemberId    String?
  postedBy            CompanyMember?                @relation("MaterialIssuePoster", fields: [postedByMemberId, companyId], references: [id, companyId])
  cancelledAt         DateTime?
  cancelledByMemberId String?
  cancelledBy         CompanyMember?                @relation("MaterialIssueCanceller", fields: [cancelledByMemberId, companyId], references: [id, companyId])
  cancellationReason  String?
  createdAt           DateTime                      @default(now())
  updatedAt           DateTime                      @updatedAt
  lines               ProductionMaterialIssueLine[]
  movements           StockMovement[]

  @@unique([companyId, number])
  @@unique([id, branchId, companyId])
  @@unique([id, productionOrderId])
  @@index([companyId, branchId, status, updatedAt])
  @@index([productionOrderId])
}

/// One reservation (exact location and lot) and the quantity to take from it.
model ProductionMaterialIssueLine {
  id                String                        @id @default(cuid())
  companyId         String
  branchId          String
  issueId           String
  productionOrderId String
  issue             ProductionMaterialIssue       @relation(fields: [issueId, productionOrderId], references: [id, productionOrderId], onDelete: Cascade)
  lineNo            Int
  materialId        String
  allocationId      String
  allocation        ProductionMaterialAllocation  @relation("ProductionIssueLineAllocation", fields: [allocationId, productionOrderId, materialId, locationId, lotKey], references: [id, productionOrderId, materialId, locationId, lotKey])
  itemId            String
  item              Item                          @relation("ProductionIssueLineItem", fields: [itemId, companyId], references: [id, companyId])
  locationId        String
  location          WarehouseLocation             @relation("ProductionIssueLineLocation", fields: [locationId, branchId], references: [id, branchId])
  lotId             String?
  lot               InventoryLot?                 @relation("ProductionIssueLineLot", fields: [lotId, itemId, companyId], references: [id, itemId, companyId])
  lotKey            String
  quantity          Decimal                       @db.Decimal(18, 6)
  createdAt         DateTime                      @default(now())
  consumption       ProductionMaterialAllocation? @relation("ProductionAllocationConsumption")
  movements         StockMovement[]

  @@unique([issueId, lineNo])
  @@index([allocationId])
}

/// What production reports having used of an issued material — evidence only, never a movement.
model ProductionMaterialUsage {
  id                 String                  @id @default(cuid())
  companyId          String
  productionOrderId  String
  materialId         String
  material           ProductionOrderMaterial @relation(fields: [materialId, productionOrderId], references: [id, productionOrderId])
  quantity           Decimal                 @db.Decimal(18, 6)
  note               String?
  recordedByMemberId String
  recordedBy         CompanyMember           @relation("MaterialUsageRecorder", fields: [recordedByMemberId, companyId], references: [id, companyId])
  recordedAt         DateTime                @default(now())

  @@index([productionOrderId, materialId])
}

// Finished goods output, receipt and production completion (EP38) —
// docs/PRODUCTION_OUTPUT.md, docs/PRODUCTION_FINISHED_GOODS_RECEIPT.md,
// docs/PRODUCTION_COMPLETION.md. Reporting output moves nothing; only a POSTED
// finished goods receipt writes PRODUCTION_OUTPUT through ledger.ts.

enum ProductionOutputStatus {
  DRAFT
  SUBMITTED
  ACCEPTED
  REJECTED
  CANCELLED
}

enum FinishedGoodsReceiptStatus {
  DRAFT
  POSTED
  CANCELLED
  REVERSED
}

enum ProductionCompletionOutcome {
  COMPLETED
  SHORT_CLOSED
}

/// One production result of an order (its finished item and unit): good, defective, pending quality.
model ProductionOutputReport {
  id                  String                   @id @default(cuid())
  companyId           String
  branchId            String
  branch              Branch                   @relation(fields: [branchId, companyId], references: [id, companyId])
  productionOrderId   String
  order               ProductionOrder          @relation(fields: [productionOrderId, branchId, companyId], references: [id, branchId, companyId])
  number              String
  status              ProductionOutputStatus   @default(DRAFT)
  productionDate      DateTime                 @db.Date
  goodQuantity        Decimal                  @db.Decimal(18, 6)
  defectiveQuantity   Decimal                  @default(0) @db.Decimal(18, 6)
  pendingQuantity     Decimal                  @default(0) @db.Decimal(18, 6)
  /// Set at acceptance: good + the pending part judged good / defective + the rest.
  acceptedQuantity    Decimal?                 @db.Decimal(18, 6)
  rejectedQuantity    Decimal?                 @db.Decimal(18, 6)
  note                String?
  createdByMemberId   String
  createdBy           CompanyMember            @relation("OutputReportCreator", fields: [createdByMemberId, companyId], references: [id, companyId])
  submittedAt         DateTime?
  submittedByMemberId String?
  submittedBy         CompanyMember?           @relation("OutputReportSubmitter", fields: [submittedByMemberId, companyId], references: [id, companyId])
  reviewedAt          DateTime?
  reviewedByMemberId  String?
  reviewedBy          CompanyMember?           @relation("OutputReportReviewer", fields: [reviewedByMemberId, companyId], references: [id, companyId])
  rejectionReason     String?
  cancelledAt         DateTime?
  cancelledByMemberId String?
  cancelledBy         CompanyMember?           @relation("OutputReportCanceller", fields: [cancelledByMemberId, companyId], references: [id, companyId])
  cancellationReason  String?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  receipts            ProductionGoodsReceipt[]

  @@unique([companyId, number])
  @@unique([id, productionOrderId])
  @@index([companyId, branchId, status, updatedAt])
  @@index([productionOrderId, status])
}

/// Warehouse receipt of accepted good output into stock: FGR-YYYYMM-NNNNNN.
model ProductionGoodsReceipt {
  id                  String                       @id @default(cuid())
  companyId           String
  branchId            String
  branch              Branch                       @relation(fields: [branchId, companyId], references: [id, companyId])
  productionOrderId   String
  order               ProductionOrder              @relation(fields: [productionOrderId, branchId, companyId], references: [id, branchId, companyId])
  outputReportId      String
  outputReport        ProductionOutputReport       @relation(fields: [outputReportId, productionOrderId], references: [id, productionOrderId])
  number              String
  status              FinishedGoodsReceiptStatus   @default(DRAFT)
  note                String?
  lineCounter         Int                          @default(0)
  createdByMemberId   String
  createdBy           CompanyMember                @relation("FgReceiptCreator", fields: [createdByMemberId, companyId], references: [id, companyId])
  postedAt            DateTime?
  postedByMemberId    String?
  postedBy            CompanyMember?               @relation("FgReceiptPoster", fields: [postedByMemberId, companyId], references: [id, companyId])
  cancelledAt         DateTime?
  cancelledByMemberId String?
  cancelledBy         CompanyMember?               @relation("FgReceiptCanceller", fields: [cancelledByMemberId, companyId], references: [id, companyId])
  cancellationReason  String?
  reversedAt          DateTime?
  reversedByMemberId  String?
  reversedBy          CompanyMember?               @relation("FgReceiptReverser", fields: [reversedByMemberId, companyId], references: [id, companyId])
  reversalReason      String?
  createdAt           DateTime                     @default(now())
  updatedAt           DateTime                     @updatedAt
  lines               ProductionGoodsReceiptLine[]
  movements           StockMovement[]

  @@unique([companyId, number])
  @@unique([id, branchId, companyId])
  @@unique([id, productionOrderId])
  @@index([companyId, branchId, status, updatedAt])
  @@index([outputReportId, status])
}

model ProductionGoodsReceiptLine {
  id                String                 @id @default(cuid())
  companyId         String
  branchId          String
  receiptId         String
  productionOrderId String
  receipt           ProductionGoodsReceipt @relation(fields: [receiptId, productionOrderId], references: [id, productionOrderId], onDelete: Cascade)
  lineNo            Int
  itemId            String
  item              Item                   @relation("FgReceiptLineItem", fields: [itemId, companyId], references: [id, companyId])
  locationId        String
  location          WarehouseLocation      @relation("FgReceiptLineLocation", fields: [locationId, branchId], references: [id, branchId])
  lotNumber         String?
  expiryDate        DateTime?              @db.Date
  manufacturedDate  DateTime?              @db.Date
  /// The lot, resolved (or created) when the receipt is posted.
  lotId             String?
  lot               InventoryLot?          @relation("FgReceiptLineLot", fields: [lotId, itemId, companyId], references: [id, itemId, companyId])
  quantity          Decimal                @db.Decimal(18, 6)
  createdAt         DateTime               @default(now())
  movements         StockMovement[]

  @@unique([receiptId, lineNo])
  @@index([lotId])
}

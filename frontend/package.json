{
  "name": "@pdabliss/core-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "PDA BLISS CORE — public website and department workspaces",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && vite build --ssr src/seo/prerender.ts --outDir dist-prerender && node scripts/prerender.mjs && node scripts/verify-prerender.mjs && node scripts/perf-budget.mjs",
    "test:prerender": "node scripts/verify-prerender.mjs",
    "perf": "node scripts/perf-budget.mjs",
    "perf:budget": "node scripts/perf-budget.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "assets": "node scripts/build-assets.mjs && node scripts/build-department-scenes.mjs && node scripts/build-brand.mjs",
    "assets:brand": "node scripts/build-brand.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.182.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans-thai": "^5.3.0",
    "@hookform/resolvers": "^5.9.2",
    "@react-three/fiber": "^9.8.2",
    "@tanstack/react-query": "^5.104.5",
    "framer-motion": "^14.5.0",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.90.0",
    "react-router": "^8.5.0",
    "three": "^0.182.0",
    "zod": "^4.6.7"
  }
}
